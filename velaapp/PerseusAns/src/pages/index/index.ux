<template>
  <div class="container">
    <!-- Top Bar -->
    <div class="top-bar">
      <text class="app-title">Perseus ({{currentCategory}})</text>
      <div class="top-btns">
        <input class="sync-btn" type="button" value="同步" onclick="gotoSync" />
        <input class="settings-btn" type="button" value="设置" onclick="gotoSettings" />
      </div>
    </div>

    <!-- Main Content List -->
    <list class="list">
      <list-item type="item" for="{{ansList}}" class="list-item" onclick="gotoReader($item.id)">
        <text class="item-title">[{{$item.category || '数学'}}] {{$item.title || '无标题解析'}}</text>
        <text class="item-summary">{{$item.summary || ('共 ' + ($item.total_pages || 1) + ' 页解析')}}</text>
      </list-item>
    </list>

    <!-- Empty State / Hint if no data -->
    <div class="empty-box" if="{{ansList.length === 0}}">
      <text class="empty-text">暂无解析数据，请前往同步中心拉取</text>
    </div>

  </div>
</template>

<script>
import router from "@system.router"
import storage from "@system.storage"

export default {
  private: {
    currentCategory: "全部",
    ansList: []
  },
  onInit() {
    this.loadData();
  },
  onShow() {
    // 每次回到主页自动重新加载分类与数据，确保筛选有效且自动刷新
    this.loadData();
  },
  loadData() {
    storage.get({
      key: "current_category",
      success: (data) => {
        if (data) {
          this.currentCategory = data;
        } else {
          this.currentCategory = "全部";
        }
        this.loadLocalAnswers();
      },
      fail: () => {
        this.currentCategory = "全部";
        this.loadLocalAnswers();
      }
    });
  },
  loadLocalAnswers() {
    storage.get({
      key: "local_answers",
      success: (data) => {
        if (data) {
          try {
            let cleaned = data.trim().replace(/^\uFEFF/, '');
            let list = JSON.parse(cleaned);
            if (!Array.isArray(list)) list = [];
            
            // 确保每个 item 都有 id 和 category，对齐离线存储结构
            list = list.map(item => ({
              ...item,
              id: item.id || item.ans_id,
              category: item.category || "数学"
            }));

            if (this.currentCategory !== "全部") {
              list = list.filter(item => String(item.category).trim() === String(this.currentCategory).trim());
            }
            this.ansList = list;
          } catch(e) {
            this.ansList = [];
          }
        } else {
          this.ansList = [];
        }
      },
      fail: () => {
        this.ansList = [];
      }
    });
  },
  gotoSettings() {
    router.push({ uri: "/pages/settings" });
  },
  gotoCategory() {
    router.push({ uri: "/pages/category" });
  },
  gotoSync() {
    // 快捷跳转到增量同步中心页面（根据实际项目路径调整，通常为 /pages/sync 或类似）
    router.push({ uri: "/pages/sync" });
  },
  gotoReader(id) {
    if (!id) return;
    router.push({ uri: "/pages/reader", params: { ansId: String(id) } });
  }
}
</script>

