<template>
  <div class="container">
    <text class="title">同步中心</text>
    <text class="sub">{{hostHint}}</text>
    <div class="status-card">
      <text class="status-text">{{syncStatus}}</text>
      <text class="progress-text" if="{{totalTasks > 0}}">{{doneTasks}}/{{totalTasks}}</text>
    </div>

    <div class="debug-panel {{isFullScreenLog ? 'debug-fullscreen' : ''}}" if="{{debugMode}}">
      <div class="debug-header">
        <text class="debug-title">Sync 日志</text>
        <input class="debug-toggle-btn" type="button" value="{{isFullScreenLog ? '收起' : '全屏'}}" onclick="toggleFullScreenLog" />
      </div>
      <scroll class="debug-scroll" scroll-y="true">
        <text class="debug-text">{{debugLog}}</text>
      </scroll>
    </div>

    <input class="btn accent" if="{{!isFullScreenLog}}" type="button" value="增量同步" onclick="startSync" />
    <input class="btn" if="{{!isFullScreenLog}}" type="button" value="全量拉取" onclick="startFullPull" />
    <input class="btn ghost" if="{{!isFullScreenLog}}" type="button" value="返回" onclick="goBack" />
  </div>
</template>

<script>
import router from "@system.router"
import fetch from "@system.fetch"
import prompt from "@system.prompt"
import store from "../../common/ansstore.js"

export default {
  private: {
    syncStatus: "增量=只拉队列；全量=按服务端题目列表重拉",
    hostHint: "",
    isSyncing: false,
    debugMode: false,
    debugLog: "等待同步",
    isFullScreenLog: false,
    serverHost: "",
    totalTasks: 0,
    doneTasks: 0
  },
  onInit() {
    this.prepare()
  },
  onShow() {
    this.prepare()
  },
  prepare() {
    store.storageGet("debug_mode", (raw) => {
      this.debugMode = (raw === "true" || raw === true)
    })
    store.getServerHost((host) => {
      this.serverHost = host
      this.hostHint = host
    })
  },
  logDebug(msg) {
    console.log("[SyncDebug] " + msg)
    if (this.debugMode) {
      this.debugLog = msg + "\n" + (this.debugLog || "")
    }
  },
  toggleFullScreenLog() {
    this.isFullScreenLog = !this.isFullScreenLog
  },
  fetchJson(url, options, onOk, onFail) {
    const req = options || {}
    req.url = url
    req.success = (response) => {
      try {
        const body = response && response.data !== undefined ? response.data : response
        const json = store.parseJson(body, null)
        if (!json) {
          throw new Error("响应不是 JSON")
        }
        onOk(json)
      } catch (e) {
        this.logDebug("解析失败 " + url + " " + e.message)
        if (onFail) onFail(e.message)
      }
    }
    req.fail = (data, code) => {
      this.logDebug("网络失败 " + url + " code:" + code)
      if (onFail) onFail("code:" + code)
    }
    fetch.fetch(req)
  },
  normalizeAnswer(ansItem, fallbackTitle, fallbackCategory) {
    const item = ansItem || {}
    if (!item.id && item.ans_id) item.id = item.ans_id
    if (!item.ans_id && item.id) item.ans_id = item.id
    if (!item.title) item.title = fallbackTitle || "未命名解析"
    if (!item.category) item.category = fallbackCategory || "数学"
    if (!item.pages || !Array.isArray(item.pages) || item.pages.length === 0) {
      item.pages = [{
        page_index: 1,
        blocks: [{
          block_type: "paragraph",
          type: "paragraph",
          raw: item.raw_text || item.content || "暂无详细内容",
          value: item.raw_text || item.content || "暂无详细内容",
          ast: ["t", item.raw_text || item.content || "暂无详细内容"]
        }]
      }]
    }
    item.total_pages = item.pages.length
    item.summary = store.buildSummary(item)
    delete item.raw_text
    return item
  },
  startSync() {
    this.beginQueue("tasks")
  },
  startFullPull() {
    this.beginQueue("full")
  },
  beginQueue(mode) {
    if (this.isSyncing) {
      prompt.showToast({ message: "正在同步" })
      return
    }
    this.isSyncing = true
    this.doneTasks = 0
    this.totalTasks = 0
    this.syncStatus = mode === "full" ? "正在获取题目列表..." : "正在获取增量任务..."
    this.logDebug("=== 开始 " + mode + " ===")
    store.getServerHost((host) => {
      this.serverHost = host
      this.hostHint = host
      if (mode === "full") {
        this.fetchJson(host + "/watch/pans/list", { method: "GET" }, (data) => {
          const items = data.items || []
          const tasks = []
          for (let i = 0; i < items.length; i++) {
            tasks.push({
              id: "full_" + (items[i].ans_id || items[i].id),
              action: "download",
              ans_id: items[i].ans_id || items[i].id,
              title: items[i].title,
              category: items[i].category,
              skipAck: true
            })
          }
          this.runTasks(tasks)
        }, (err) => {
          this.failSync("获取列表失败 " + err)
        })
      } else {
        this.fetchJson(host + "/watch/pans/tasks", { method: "GET" }, (data) => {
          this.runTasks(data.tasks || [])
        }, (err) => {
          this.failSync("获取队列失败 " + err)
        })
      }
    })
  },
  runTasks(tasks) {
    if (!tasks.length) {
      this.syncStatus = "没有待同步题目。可点「全量拉取」"
      prompt.showToast({ message: "队列为空" })
      this.isSyncing = false
      return
    }
    this.totalTasks = tasks.length
    this.syncStatus = "共 " + tasks.length + " 项，开始下载"
    this.processTaskQueue(tasks, 0, [])
  },
  failSync(msg) {
    this.syncStatus = msg
    this.isSyncing = false
  },
  processTaskQueue(tasks, index, syncedTitles) {
    if (index >= tasks.length) {
      const summary = syncedTitles.length ? ("完成: " + syncedTitles.join("、")) : "同步完成"
      this.syncStatus = summary
      this.doneTasks = tasks.length
      prompt.showToast({ message: summary })
      this.isSyncing = false
      return
    }
    const task = tasks[index]
    const taskId = task.id || task.task_id
    const taskTitle = task.title || task.ans_id || ("任务" + (index + 1))
    this.doneTasks = index
    this.syncStatus = "下载 " + (index + 1) + "/" + tasks.length + " " + taskTitle
    this.logDebug("任务 " + taskTitle + " action=" + task.action)

    if (task.action === "download" && task.ans_id) {
      const downloadUrl = this.serverHost + "/watch/pans/get/" + task.ans_id + "?compact=1"
      this.fetchJson(downloadUrl, { method: "GET" }, (resJson) => {
        if (resJson.status === "success" && resJson.data) {
          const ansItem = this.normalizeAnswer(resJson.data, task.title, task.category)
          this.logDebug("写入 " + ansItem.id + " pages=" + (ansItem.pages ? ansItem.pages.length : 0))
          store.upsertAnswer(ansItem, (ok, code) => {
            if (!ok) this.logDebug("存储失败 code:" + code + " 仍写入索引")
            syncedTitles.push(ansItem.title || taskTitle)
            this.afterItem(task, taskId, () => {
              this.processTaskQueue(tasks, index + 1, syncedTitles)
            })
          })
        } else {
          this.logDebug("服务端无数据，跳过")
          this.afterItem(task, taskId, () => {
            this.processTaskQueue(tasks, index + 1, syncedTitles)
          })
        }
      }, () => {
        this.syncStatus = "下载失败，1.5秒后重试"
        setTimeout(() => {
          this.processTaskQueue(tasks, index, syncedTitles)
        }, 1500)
      })
    } else {
      this.afterItem(task, taskId, () => {
        this.processTaskQueue(tasks, index + 1, syncedTitles)
      })
    }
  },
  afterItem(task, taskId, callback) {
    if (task.skipAck || !taskId) {
      if (callback) callback()
      return
    }
    this.fetchJson(this.serverHost + "/watch/pans/task/ack", {
      method: "POST",
      header: { "Content-Type": "application/json" },
      data: JSON.stringify({ task_id: taskId })
    }, () => {
      this.logDebug("ACK " + taskId)
      if (callback) callback()
    }, () => {
      this.logDebug("ACK 失败仍继续")
      if (callback) callback()
    })
  },
  goBack() {
    router.back()
  }
}
</script>

<style>
.container {
  flex-direction: column;
  background-color: #0b0d12;
  width: 100%;
  height: 100%;
  padding: 12px;
  align-items: center;
  justify-content: center;
}
.title {
  font-size: 16px;
  color: #f3f5f8;
  font-weight: bold;
  margin-bottom: 4px;
}
.sub {
  font-size: 9px;
  color: #6b7280;
  margin-bottom: 8px;
  text-align: center;
}
.status-card {
  width: 100%;
  background-color: #151a24;
  border-radius: 10px;
  padding: 10px;
  margin-bottom: 10px;
  align-items: center;
}
.status-text {
  font-size: 12px;
  color: #86efac;
  text-align: center;
}
.progress-text {
  font-size: 10px;
  color: #f5c15d;
  margin-top: 4px;
}
.debug-panel {
  width: 100%;
  height: 90px;
  background-color: #141821;
  border-radius: 8px;
  padding: 8px;
  margin-bottom: 8px;
  flex-direction: column;
}
.debug-fullscreen {
  position: absolute;
  left: 0;
  top: 0;
  width: 100%;
  height: 90%;
  background-color: #0f1218;
  z-index: 999;
  padding: 10px;
}
.debug-header {
  flex-direction: row;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 4px;
}
.debug-title {
  font-size: 10px;
  color: #f5c15d;
  font-weight: bold;
}
.debug-toggle-btn {
  width: 40px;
  height: 20px;
  background-color: #7f1d1d;
  color: #ffffff;
  font-size: 9px;
  border-radius: 10px;
}
.debug-scroll {
  flex: 1;
}
.debug-text {
  font-size: 9px;
  color: #b7c0d1;
}
.btn {
  width: 160px;
  height: 32px;
  background-color: #243044;
  color: #ffffff;
  font-size: 13px;
  border-radius: 16px;
  margin-bottom: 8px;
}
.accent {
  background-color: #d97706;
}
.ghost {
  background-color: #1a1f2b;
}
</style>
