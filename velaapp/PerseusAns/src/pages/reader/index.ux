<template>
  <div class="container">
    <div class="top-bar">
      <text class="title">{{ansTitle}}</text>
      <text class="page-indicator">{{currentPage + 1}}/{{totalPages}}</text>
    </div>

    <scroll class="reader-scroll" scroll-x="true" scroll-y="true">
      <div class="content-body">
        <block for="{{pageNodes}}">
          <text class="h1" if="{{$item.type === 'h1'}}">{{$item.value}}</text>
          <text class="h2" if="{{$item.type === 'h2'}}">{{$item.value}}</text>
          <text class="h3" if="{{$item.type === 'h3'}}">{{$item.value}}</text>

          <div class="paragraph" if="{{$item.type === 'm' || $item.type === 'paragraph'}}">
            <block for="{{$item.children}}">
              <text class="text" if="{{$item.type === 't'}}">{{$item.value}}</text>
              <text class="bold-text" if="{{$item.type === 'bold'}}">{{$item.value}}</text>

              <div class="ast-horizontal" if="{{$item.type === 'r'}}">
                <block for="{{$item.children}}">
                  <text class="text" if="{{$item.type === 't'}}">{{$item.value}}</text>
                  <text class="bold-text" if="{{$item.type === 'bold'}}">{{$item.value}}</text>
                  <div class="ast-fraction" if="{{$item.type === 'f'}}">
                    <text class="ast-num">{{$item.numText}}</text>
                    <div class="ast-line"></div>
                    <text class="ast-den">{{$item.denText}}</text>
                  </div>
                  <div class="ast-sup-wrap" if="{{$item.type === 'sup_g'}}">
                    <text class="text">{{$item.baseText}}</text>
                    <text class="ast-sup">{{$item.supText}}</text>
                  </div>
                  <div class="ast-sub-wrap" if="{{$item.type === 'sub_g'}}">
                    <text class="text">{{$item.baseText}}</text>
                    <text class="ast-sub">{{$item.subText}}</text>
                  </div>
                </block>
              </div>

              <div class="ast-fraction" if="{{$item.type === 'f'}}">
                <text class="ast-num">{{$item.numText}}</text>
                <div class="ast-line"></div>
                <text class="ast-den">{{$item.denText}}</text>
              </div>

              <div class="ast-sqrt" if="{{$item.type === 'sq'}}">
                <text class="ast-symbol">√</text>
                <text class="ast-sqrt-text">{{$item.contentText}}</text>
              </div>

              <div class="ast-sup-wrap" if="{{$item.type === 'sup_g'}}">
                <text class="text">{{$item.baseText}}</text>
                <text class="ast-sup">{{$item.supText}}</text>
              </div>

              <div class="ast-sub-wrap" if="{{$item.type === 'sub_g'}}">
                <text class="text">{{$item.baseText}}</text>
                <text class="ast-sub">{{$item.subText}}</text>
              </div>

              <div class="ast-vec-wrap" if="{{$item.type === 'vec'}}">
                <text class="ast-vec-arrow">→</text>
                <text class="text">{{$item.contentText}}</text>
              </div>

              <div class="chem-seq-container" if="{{$item.type === 'chem_seq'}}">
                <block for="{{$item.children}}">
                  <text class="text" if="{{$item.type === 't'}}">{{$item.value}}</text>
                  <div class="chem-arrow-box" if="{{$item.type === 'chem_a'}}">
                    <text class="chem-arrow-top">{{$item.topText}}</text>
                    <text class="chem-arrow-symbol">{{$item.symbol}}</text>
                    <text class="chem-arrow-bot">{{$item.botText}}</text>
                  </div>
                </block>
              </div>
            </block>
          </div>
        </block>
      </div>
    </scroll>

    <div class="bottom-bar">
      <input class="btn" type="button" value="上一页" onclick="prevPage" />
      <input class="btn" type="button" value="下一页" onclick="nextPage" />
      <input class="btn-danger" type="button" value="删除" onclick="confirmDelete" />
    </div>
  </div>
</template>

<script>
import router from "@system.router"
import prompt from "@system.prompt"
import store from "../../common/ansstore.js"

export default {
  private: {
    ansId: null,
    ansTitle: "",
    totalPages: 1,
    currentPage: 0,
    pagesData: [],
    pageNodes: [],
    fontSize: 14
  },
  onInit(params) {
    const p = params || this
    this.ansId = p.ansId || p.ans_id
    store.storageGet("reader_font_size", (data) => {
      const size = parseInt(data, 10)
      if (!isNaN(size)) this.fontSize = size
    })
    this.loadAnswerData()
  },
  loadAnswerData() {
    store.loadItem(this.ansId, (item) => {
      if (!item) {
        this.ansTitle = "未找到题目"
        this.pageNodes = [{ type: "m", children: [{ type: "t", value: "本地无此题，请重新同步" }] }]
        return
      }
      this.ansTitle = item.title || "解析"
      this.pagesData = item.pages || []
      this.totalPages = item.total_pages || this.pagesData.length || 1
      this.updatePageContent()
    })
  },
  nodeText(node) {
    if (!node) return ""
    if (typeof node === "string" || typeof node === "number") return String(node)
    if (node.type === "t" || node.type === "bold") return node.value || ""
    if (node.value) return String(node.value)
    return store.astText(node)
  },
  normalizeAst(node) {
    if (node === undefined || node === null) return { type: "t", value: "" }
    if (typeof node === "string" || typeof node === "number") {
      return { type: "t", value: String(node) }
    }
    if (Array.isArray(node)) {
      const tag = node[0]
      if (tag === "t" || tag === "txt") return { type: "t", value: String(node[1] || "") }
      if (tag === "r") {
        return { type: "r", children: store.rowChildren(node).map((n) => this.normalizeAst(n)) }
      }
      if (tag === "f") {
        const num = this.normalizeAst(node[1])
        const den = this.normalizeAst(node[2])
        return { type: "f", num: num, den: den, numText: this.nodeText(num), denText: this.nodeText(den) }
      }
      if (tag === "sq") {
        const content = this.normalizeAst(node[1])
        return { type: "sq", content: content, contentText: this.nodeText(content) }
      }
      if (tag === "sup_g" || tag === "sup") {
        const base = tag === "sup" ? { type: "t", value: "" } : this.normalizeAst(node[1])
        const sup = this.normalizeAst(tag === "sup" ? node[1] : node[2])
        return { type: "sup_g", base: base, sup: sup, baseText: this.nodeText(base), supText: this.nodeText(sup) }
      }
      if (tag === "sub_g" || tag === "sub") {
        const base = tag === "sub" ? { type: "t", value: "" } : this.normalizeAst(node[1])
        const sub = this.normalizeAst(tag === "sub" ? node[1] : node[2])
        return { type: "sub_g", base: base, sub: sub, baseText: this.nodeText(base), subText: this.nodeText(sub) }
      }
      if (tag === "vec") {
        const content = this.normalizeAst(node[1])
        return { type: "vec", content: content, contentText: this.nodeText(content) }
      }
      if (tag === "chem_seq") {
        const kids = Array.isArray(node[1]) ? node[1] : node.slice(1)
        return { type: "chem_seq", children: kids.map((n) => this.normalizeAst(n)) }
      }
      if (tag === "chem_a") {
        const top = this.normalizeAst(node[2])
        const bot = this.normalizeAst(node[3])
        return {
          type: "chem_a",
          symbol: node[1] || "→",
          top: top,
          bot: bot,
          topText: this.nodeText(top),
          botText: this.nodeText(bot)
        }
      }
      if (tag === "h1" || tag === "h2" || tag === "h3") {
        return { type: tag, value: String(node[1] || "") }
      }
      if (tag === "m" || tag === "paragraph") {
        return { type: "m", children: node.slice(1).map((n) => this.normalizeAst(n)) }
      }
      return { type: "t", value: store.astText(node) }
    }
    if (typeof node === "object") {
      const blockType = node.block_type || node.type
      if (blockType === "h1" || blockType === "h2" || blockType === "h3") {
        return { type: blockType, value: node.raw || node.value || store.astText(node.ast) }
      }
      const source = node.ast || node.content || node.children
      let children = []
      if (Array.isArray(source) && source.length && source[0] === "r") {
        children = store.rowChildren(source).map((n) => this.normalizeAst(n))
      } else if (Array.isArray(source) && source.length && typeof source[0] === "string") {
        children = [this.normalizeAst(source)]
      } else if (Array.isArray(source)) {
        children = source.map((n) => this.normalizeAst(n))
      } else if (source) {
        children = [this.normalizeAst(source)]
      } else if (node.raw || node.value) {
        children = [{ type: "t", value: node.raw || node.value }]
      }
      return { type: "m", children: children }
    }
    return { type: "t", value: String(node) }
  },
  updatePageContent() {
    if (!this.pagesData || this.pagesData.length <= this.currentPage) {
      this.pageNodes = [{ type: "m", children: [{ type: "t", value: "本页为空" }] }]
      return
    }
    const currentPageObj = this.pagesData[this.currentPage]
    let rawBlocks = []
    if (currentPageObj && currentPageObj.blocks) rawBlocks = currentPageObj.blocks
    else if (Array.isArray(currentPageObj)) rawBlocks = currentPageObj
    this.pageNodes = rawBlocks.map((block) => this.normalizeAst(block))
  },
  prevPage() {
    if (this.currentPage > 0) {
      this.currentPage--
      this.updatePageContent()
    }
  },
  nextPage() {
    if (this.currentPage < this.totalPages - 1) {
      this.currentPage++
      this.updatePageContent()
    }
  },
  confirmDelete() {
    prompt.showDialog({
      title: "确认删除",
      message: "删除本机这道题？",
      buttons: [
        { text: "取消", color: "#888888" },
        { text: "删除", color: "#ef4444" }
      ],
      success: (data) => {
        const idx = data && (data.index !== undefined ? data.index : (data.data && data.data.index))
        if (Number(idx) !== 1) return
        store.deleteAnswer(this.ansId, () => {
          prompt.showToast({ message: "已删除" })
          router.back()
        })
      }
    })
  }
}
</script>

<style>
.container {
  flex-direction: column;
  background-color: #0b0d12;
  width: 100%;
  height: 100%;
  padding: 8px;
}
.top-bar {
  flex-direction: row;
  justify-content: space-between;
  align-items: center;
  height: 32px;
  border-bottom-width: 1px;
  border-bottom-color: #243044;
}
.title {
  font-size: 13px;
  color: #f5c15d;
  font-weight: bold;
  flex: 1;
  lines: 1;
  text-overflow: ellipsis;
}
.page-indicator {
  font-size: 11px;
  color: #9aa3b5;
  margin-left: 6px;
}
.reader-scroll {
  flex: 1;
  margin-top: 6px;
  margin-bottom: 6px;
}
.content-body {
  flex-direction: column;
  padding: 4px;
}
.h1 {
  font-size: 17px;
  font-weight: bold;
  color: #ffffff;
  margin-bottom: 6px;
}
.h2 {
  font-size: 15px;
  font-weight: bold;
  color: #e5e7eb;
  margin-bottom: 5px;
}
.h3 {
  font-size: 13px;
  font-weight: bold;
  color: #d1d5db;
  margin-bottom: 4px;
}
.paragraph {
  flex-direction: row;
  flex-wrap: wrap;
  margin-bottom: 6px;
  align-items: center;
}
.text {
  font-size: 13px;
  color: #e5e7eb;
}
.bold-text {
  font-size: 13px;
  color: #f5c15d;
  font-weight: bold;
}
.ast-horizontal {
  flex-direction: row;
  align-items: center;
  margin: 0px 2px;
}
.ast-fraction {
  flex-direction: column;
  align-items: center;
  margin: 0px 4px;
}
.ast-num {
  font-size: 11px;
  color: #67e8f9;
  padding-bottom: 1px;
}
.ast-line {
  width: 100%;
  height: 1px;
  background-color: #67e8f9;
}
.ast-den {
  font-size: 11px;
  color: #67e8f9;
  padding-top: 1px;
}
.ast-sqrt {
  flex-direction: row;
  align-items: center;
  margin: 0px 4px;
}
.ast-symbol {
  font-size: 14px;
  color: #e879f9;
}
.ast-sqrt-text {
  font-size: 12px;
  color: #e879f9;
  border-top-width: 1px;
  border-top-color: #e879f9;
  padding-top: 1px;
}
.ast-sup-wrap {
  flex-direction: row;
  align-items: flex-start;
}
.ast-sup {
  font-size: 9px;
  color: #38bdf8;
  margin-left: 1px;
}
.ast-sub-wrap {
  flex-direction: row;
  align-items: flex-end;
}
.ast-sub {
  font-size: 9px;
  color: #38bdf8;
  margin-left: 1px;
}
.ast-vec-wrap {
  flex-direction: row;
  align-items: center;
}
.ast-vec-arrow {
  font-size: 9px;
  color: #fb923c;
}
.chem-seq-container {
  flex-direction: row;
  align-items: center;
  flex-wrap: wrap;
}
.chem-arrow-box {
  flex-direction: column;
  align-items: center;
  margin: 0px 4px;
}
.chem-arrow-top {
  font-size: 8px;
  color: #c4b5fd;
}
.chem-arrow-symbol {
  font-size: 12px;
  color: #c4b5fd;
}
.chem-arrow-bot {
  font-size: 8px;
  color: #c4b5fd;
}
.bottom-bar {
  flex-direction: row;
  justify-content: space-between;
  height: 34px;
  align-items: center;
}
.btn {
  width: 86px;
  height: 28px;
  background-color: #243044;
  color: #ffffff;
  font-size: 11px;
  border-radius: 14px;
}
.btn-danger {
  width: 64px;
  height: 28px;
  background-color: #7f1d1d;
  color: #ffffff;
  font-size: 11px;
  border-radius: 14px;
}
</style>
