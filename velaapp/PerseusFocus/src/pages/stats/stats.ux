<template>
  <div class="container">
    <text class="page-title">学习统计看板</text>

    <!-- 总时长展示 -->
    <div class="summary-card">
      <text class="summary-label">总学习时长</text>
      <text class="summary-value">{{ totalMinutes }} 分钟</text>
    </div>

    <!-- 科目统计列表 -->
    <text class="section-title">各科目投入时长</text>
    <div class="list-container">
      <div for="{{ statsList }}" class="stat-item">
        <text class="sub-name">{{ $item.name }}</text>
        <div class="bar-bg">
          <div class="bar-fill" style="width: {{ $item.percent }}%;"></div>
        </div>
        <text class="sub-time">{{ $item.minutes }}分钟({{ $item.percent }}%)</text>
      </div>
    </div>

    <div class="bottom-btns">
      <input class="nav-btn" type="button" value="智能规划" onclick="gotoPlan" />
      <input class="nav-btn" type="button" value="返回首页" onclick="goHome" />
    </div>
  </div>
</template>

<script>
import router from "@system.router";
import storage from "@system.storage";
import { SUBJECTS, STORAGE_KEY } from "../../common/constants.js";

export default {
  private: {
    totalMinutes: 0,
    statsList: []
  },

  onInit() {
    this.loadStats();
  },

  loadStats() {
    storage.get({
      key: STORAGE_KEY,
      success: (data) => {
        if (!data) return;
        try {
          const list = JSON.parse(data);
          let totals = {};
          SUBJECTS.forEach(s => {
            totals[s.id] = { name: s.name, minutes: 0 };
          });

          let sum = 0;
          list.forEach(item => {
            if (totals[item.subjectId]) {
              totals[item.subjectId].minutes += item.minutes;
              sum += item.minutes;
            }
          });

          this.totalMinutes = sum;

          let res = [];
          SUBJECTS.forEach(s => {
            const m = totals[s.id].minutes;
            const pct = sum > 0 ? Math.round((m / sum) * 100) : 0;
            res.push({
              id: s.id,
              name: s.name,
              minutes: m,
              percent: pct
            });
          });
          this.statsList = res;
        } catch (e) {}
      }
    });
  },

  gotoPlan() {
    router.push({ uri: "/pages/plan" });
  },

  goHome() {
    router.replace({ uri: "/pages/index" });
  }
};
</script>

