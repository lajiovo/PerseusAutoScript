<template>
  <div class="container">
    <text class="page-title">智能规划与加权失衡分析</text>

    <!-- 建议展示卡片 -->
    <div class="advice-card">
      <text class="advice-title">智能诊断与基准总时长 ({{ defaultDailyMinutes }}分钟)</text>
      <text class="advice-content">{{ adviceText }}</text>
    </div>

    <!-- 权重对照说明 -->
    <text class="section-title">精确权重算法及科目投入判定</text>
    <div class="list-container">
      <div for="{{ analysisList }}" class="analysis-item">
        <text class="item-name" style="color: {{ $item.color }};">{{ $item.name }} (权{{ $item.weight }})</text>
        <text class="item-score">投入: {{ $item.minutes }}分</text>
        <text class="item-status {{ $item.statusType }}">{{ $item.status }}</text>
      </div>
    </div>

    <div class="bottom-btns">
      <input class="nav-btn" type="button" value="一键同步" onclick="gotoSync" />
      <input class="nav-btn" type="button" value="返回统计" onclick="goStats" />
    </div>
  </div>
</template>

<script>
import router from "@system.router";
import storage from "@system.storage";
import { SUBJECTS, STORAGE_KEY, DEFAULT_DAILY_MINUTES } from "../../common/constants.js";

export default {
  private: {
    adviceText: "正在进行加权投入分析...",
    analysisList: [],
    defaultDailyMinutes: DEFAULT_DAILY_MINUTES
  },

  onInit() {
    this.analyze();
  },

  analyze() {
    storage.get({
      key: STORAGE_KEY,
      success: (data) => {
        let totals = {};
        SUBJECTS.forEach(s => {
          totals[s.id] = 0;
        });

        if (data) {
          try {
            const list = JSON.parse(data);
            list.forEach(item => {
              if (totals[item.subjectId] !== undefined) {
                totals[item.subjectId] += item.minutes;
              }
            });
          } catch (e) {}
        }

        // 总权重和
        const totalWeight = SUBJECTS.reduce((acc, s) => acc + s.weight, 0);

        // 各科目基于权重的期望标准分钟数
        // 权重占比 * 默认每日基准总时长 (300分钟)
        let subjectScores = SUBJECTS.map(s => {
          const actualMins = totals[s.id];
          const expectedMins = (s.weight / totalWeight) * this.defaultDailyMinutes;
          
          let status = "正常均衡";
          let statusType = "normal-status";

          if (actualMins < expectedMins * 0.7) {
            status = "投入不足";
            statusType = "warn-status";
          } else if (actualMins > expectedMins * 1.4) {
            status = "过度投入";
            statusType = "over-status";
          }

          return {
            id: s.id,
            name: s.name,
            weight: s.weight,
            color: s.color,
            minutes: actualMins,
            expected: Math.round(expectedMins),
            status: status,
            statusType: statusType
          };
        });

        this.analysisList = subjectScores;

        // 诊断文案
        const deficient = subjectScores.filter(s => s.status === "投入不足");
        if (deficient.length > 0) {
          const names = deficient.map(d => d.name).join("、");
          this.adviceText = `加权算法提示：当前高权重科目 [${names}] 投入时间明显低于标准线，建议重点补强！`;
        } else {
          this.adviceText = `加权算法提示：当前每日基准 (${this.defaultDailyMinutes}分钟) 统筹达标，各科目投入均在合理区间！`;
        }
      },
      fail: () => {
        this.adviceText = "暂无学习记录，请先去打卡记录时间。";
      }
    });
  },

  gotoSync() {
    router.push({ uri: "/pages/sync" });
  },

  goStats() {
    router.back();
  }
};
</script>

