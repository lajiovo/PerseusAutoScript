  border-radius: 12px;
  flex-direction: column;
  justify-content: center;
  align-items: center;
  padding: 15px;
  margin-bottom: 25px;
}

.target-label {
  font-size: 14px;
  color: #94a3b8;
  margin-bottom: 5px;
}

.target-url {
  font-size: 15px;
  color: #38bdf8;
  font-weight: bold;
  margin-bottom: 15px;
  text-align: center;
}

.status-text {
  font-size: 14px;
