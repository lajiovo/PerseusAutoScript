<template>
  <div class="container">
    <text class="page-title">智能规划与双对比视图</text>

    <!-- 视图切换栏 -->
    <div class="tab-bar">
      <text class="tab-btn {{ viewMode === 'sufficiency' ? 'active-tab' : '' }}" onclick="switchView('sufficiency')">视图一: 投入充足度对比</text>
      <text class="tab-btn {{ viewMode === 'golden' ? 'active-tab' : '' }}" onclick="switchView('golden')">视图二: 黄金比例对比</text>
    </div>

    <!-- 视图一：科目投入充足度对比（实际投入 vs 加权建议标准） -->
    <div if="{{ viewMode === 'sufficiency' }}" class="view-box">
      <div class="view-header">
        <text class="vh-title">科目实际投入 vs 加权建议标准</text>
      </div>
      <div class="list-container">
        <div for="{{ analysisList }}" class="analysis-item">
          <text class="item-name" style="color: {{ $item.color }};">{{ $item.name }}</text>
          <text class="item-score">实际{{ $item.minutes }}分 / 标{{ $item.expected }}分</text>
          <text class="item-status {{ $item.statusType }}">{{ $item.status }}</text>
        </div>
      </div>
    </div>

    <!-- 视图二：科目黄金比例对比（实际占比 vs 权重目标比例） -->
    <div if="{{ viewMode === 'golden' }}" class="view-box">
      <div class="view-header">
        <text class="vh-title">科目实际占比 vs 权重目标比例</text>
      </div>
      <div class="list-container">
        <div for="{{ analysisList }}" class="analysis-item">
          <text class="item-name" style="color: {{ $item.color }};">{{ $item.name }}</text>
          <text class="item-score">实际{{ $item.actualPercent }}% / 权重{{ $item.targetPercent }}%</text>
          <text class="item-status {{ $item.goldenStatusType }}">{{ $item.goldenStatus }}</text>
        </div>
      </div>
    </div>

    <div class="bottom-btns">
      <input class="nav-btn" type="button" value="一键同步" onclick="gotoSync" />
      <input class="nav-btn" type="button" value="返回统计" onclick="goStats" />
    </div>
  </div>
</template>

<script>
import router from "@system.router";
import storage from "@system.storage";
import { SUBJECTS, STORAGE_KEY, DEFAULT_DAILY_MINUTES } from "../../common/constants.js";

export default {
  private: {
    viewMode: 'sufficiency', // 'sufficiency' 或 'golden'
    analysisList: [],
    defaultDailyMinutes: DEFAULT_DAILY_MINUTES
  },

  onInit() {
    this.analyze();
  },

  switchView(m) {
    this.viewMode = m;
  },

  analyze() {
    storage.get({
      key: STORAGE_KEY,
      success: (data) => {
        let totals = {};
        SUBJECTS.forEach(s => {
          totals[s.id] = 0;
        });

        let totalRecordedMins = 0;
        if (data) {
          try {
            const list = JSON.parse(data);
            list.forEach(item => {
              if (totals[item.subjectId] !== undefined) {
                totals[item.subjectId] += item.minutes;
                totalRecordedMins += item.minutes;
              }
            });
          } catch (e) {}
        }

        // 总权重和
        const totalWeight = SUBJECTS.reduce((acc, s) => acc + s.weight, 0);

        let subjectScores = SUBJECTS.map(s => {
          const actualMins = totals[s.id];
          const expectedMins = (s.weight / totalWeight) * this.defaultDailyMinutes;
          
          // 视图一：充足度判定
          let status = "达标";
          let statusType = "normal-status";
          if (actualMins < expectedMins * 0.7) {
            status = "投入不足";
            statusType = "warn-status";
          } else if (actualMins > expectedMins * 1.4) {
            status = "过度投入";
            statusType = "over-status";
          }

          // 视图二：黄金比例对比（实际占比 vs 目标权重占比）
          const targetPercent = Math.round((s.weight / totalWeight) * 100);
          const actualPercent = totalRecordedMins > 0 ? Math.round((actualMins / totalRecordedMins) * 100) : 0;
          
          let goldenStatus = "黄金比例";
          let goldenStatusType = "normal-status";
          if (actualPercent < targetPercent - 3) {
            goldenStatus = "低于目标";
            goldenStatusType = "warn-status";
          } else if (actualPercent > targetPercent + 5) {
            goldenStatus = "高于目标";
            goldenStatusType = "over-status";
          }

          return {
            id: s.id,
            name: s.name,
            weight: s.weight,
            color: s.color,
            minutes: actualMins,
            expected: Math.round(expectedMins),
            status: status,
            statusType: statusType,
            targetPercent: targetPercent,
            actualPercent: actualPercent,
            goldenStatus: goldenStatus,
            goldenStatusType: goldenStatusType
          };
        });

        this.analysisList = subjectScores;
      },
      fail: () => {
        this.analysisList = SUBJECTS.map(s => ({
          id: s.id,
          name: s.name,
          weight: s.weight,
          color: s.color,
          minutes: 0,
          expected: 0,
          status: "暂无记录",
          statusType: "warn-status",
          targetPercent: 0,
          actualPercent: 0,
          goldenStatus: "暂无记录",
          goldenStatusType: "warn-status"
        }));
      }
    });
  },

  gotoSync() {
    router.push({ uri: "/pages/sync" });
  },

  goStats() {
    router.back();
  }
};
</script>

