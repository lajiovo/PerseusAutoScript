<template>
  <div class="container">
    <div class="top-bar">
      <div class="cat-chip" onclick="switchCategory">
        <text class="cat-label">{{currentCategory}}</text>
        <text class="cat-arrow">▾</text>
      </div>
      <div class="top-btns">
        <input class="icon-btn" type="button" value="刷新" onclick="reloadLocal" />
        <input class="icon-btn accent" type="button" value="同步" onclick="gotoSync" />
        <input class="icon-btn ghost" type="button" value="设置" onclick="gotoSettings" />
      </div>
    </div>

    <div class="stats-row">
      <text class="stats-text">{{listHint}}</text>
    </div>

    <div class="debug-panel {{isFullScreenLog ? 'debug-fullscreen' : ''}}" if="{{debugMode}}">
      <div class="debug-header">
        <text class="debug-title">Index 日志</text>
        <input class="debug-toggle-btn" type="button" value="{{isFullScreenLog ? '收起' : '全屏'}}" onclick="toggleFullScreenLog" />
      </div>
      <scroll class="debug-scroll" scroll-y="true">
        <text class="debug-text">{{debugLog}}</text>
      </scroll>
    </div>

    <list class="list" if="{{ansList.length > 0}}">
      <list-item type="ans" for="{{(item, idx) in ansList}}" tid="id" class="list-item" onclick="gotoReader" data-id="{{item.id}}">
        <div class="item-accent"></div>
        <div class="item-body">
          <div class="item-head">
            <text class="item-cat">{{item.category}}</text>
            <text class="item-flag" if="{{item.pagesEmpty || item.blocksEmpty || !item.stored}}">空</text>
          </div>
          <text class="item-title">{{item.title}}</text>
          <text class="item-summary">{{item.summary}}</text>
        </div>
      </list-item>
    </list>

    <div class="empty-box" if="{{ansList.length <= 0}}">
      <text class="empty-title">还没有题目</text>
      <text class="empty-text">点右上角「同步」从电脑拉取，或在设置里检查本地存储是否为空</text>
    </div>
  </div>
</template>

<script>
import router from "@system.router"
import prompt from "@system.prompt"
import store from "../../common/ansstore.js"

export default {
  private: {
    currentCategory: "全部",
    categories: ["全部", "数学", "物理", "化学", "综合"],
    ansList: [],
    listHint: "本地 0 题",
    debugMode: false,
    debugLog: "初始化...",
    isFullScreenLog: false
  },
  onInit() {
    this.refreshAll()
  },
  onShow() {
    this.refreshAll()
  },
  refreshAll() {
    store.storageGet("debug_mode", (raw) => {
      this.debugMode = (raw === "true" || raw === true)
      store.storageGet("current_category", (cat) => {
        this.currentCategory = cat || "全部"
        this.loadLocalAnswers()
      })
    })
  },
  logDebug(msg) {
    console.log("[IndexDebug] " + msg)
    if (this.debugMode) {
      this.debugLog = msg + "\n" + (this.debugLog || "")
    }
  },
  toggleFullScreenLog() {
    this.isFullScreenLog = !this.isFullScreenLog
  },
  loadLocalAnswers() {
    const cat = this.currentCategory
    this.logDebug("读取索引 current_category=" + cat)
    store.loadIndex((list) => {
      if (!Array.isArray(list)) list = []
      this.logDebug("索引条数 " + list.length)
      let shown = []
      for (let i = 0; i < list.length; i++) {
        const it = list[i] || {}
        const row = {
          id: String(it.id || it.ans_id || ""),
          title: it.title || "无标题解析",
          category: it.category || "数学",
          summary: it.summary || ("共 " + (it.total_pages || 1) + " 页 | " + (it.id || "")),
          total_pages: it.total_pages || 1,
          stored: it.stored !== false,
          pagesEmpty: !!it.pagesEmpty,
          blocksEmpty: !!it.blocksEmpty
        }
        if (cat === "全部" || String(row.category).trim() === String(cat).trim()) {
          shown.push(row)
        }
      }
      this.ansList = shown
      this.listHint = "本地 " + list.length + " 题 · 显示 " + shown.length + " · " + cat
      this.logDebug("渲染 " + shown.length + " 条")
    })
  },
  reloadLocal() {
    prompt.showToast({ message: "正在载入本地索引" })
    this.loadLocalAnswers()
  },
  switchCategory() {
    const idx = this.categories.indexOf(this.currentCategory)
    const nextIdx = (idx + 1) % this.categories.length
    this.currentCategory = this.categories[nextIdx]
    store.storageSet("current_category", this.currentCategory, () => {
      prompt.showToast({ message: this.currentCategory })
      this.loadLocalAnswers()
    })
  },
  gotoSettings() {
    router.push({ uri: "/pages/settings" })
  },
  gotoSync() {
    router.push({ uri: "/pages/sync" })
  },
  gotoReader(e) {
    let id = e
    if (e && typeof e === "object") {
      id = (e.target && e.target.dataset && e.target.dataset.id) || e.ansId || e.id
    }
    if (!id) return
    router.push({ uri: "/pages/reader", params: { ansId: String(id) } })
  }
}
</script>

<style>
.container {
  flex-direction: column;
  background-color: #0b0d12;
  width: 100%;
  height: 100%;
  padding: 8px 10px 10px 10px;
}
