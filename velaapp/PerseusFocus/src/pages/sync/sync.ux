<template>
  <div class="container">
    <text class="page-title">一键数据同步</text>

    <div class="sync-card">
      <text class="target-label">同步服务端地址:</text>
      <text class="target-url">{{ syncUrl }}</text>
      <text class="status-text">{{ syncStatus }}</text>
    </div>

    <input class="sync-action-btn" type="button" value="立即同步数据" onclick="startSync" />
    <input class="back-btn" type="button" value="返回首页" onclick="goHome" />
  </div>
</template>

<script>
import router from "@system.router";
import storage from "@system.storage";
import fetch from "@system.fetch";
import { STORAGE_KEY, SYNC_URL } from "../../common/constants.js";

export default {
  private: {
    syncUrl: SYNC_URL,
    syncStatus: "等待同步..."
  },

  startSync() {
    this.syncStatus = "正在连接服务端...";
    storage.get({
      key: STORAGE_KEY,
      success: (data) => {
        let records = [];
        if (data) {
          try {
            records = JSON.parse(data);
          } catch (e) {}
        }

        fetch.fetch({
          url: this.syncUrl,
          method: 'POST',
          data: JSON.stringify({ records: records, device: 'RedmiWatch6', timestamp: new Date().getTime() }),
          header: {
            'Content-Type': 'application/json'
          },
          success: (response) => {
            this.syncStatus = "同步成功！数据已上传";
          },
          fail: (data, code) => {
            // 模拟或降级提示
            this.syncStatus = "同步请求失败(可忽略局域网状态)，本地数据已安全保存";
          }
        });
      },
      fail: () => {
        this.syncStatus = "本地暂无需要同步的数据";
      }
    });
  },

  goHome() {
    router.replace({ uri: "/pages/index" });
  }
};
</script>

