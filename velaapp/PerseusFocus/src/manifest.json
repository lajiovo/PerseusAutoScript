{
  "package": "com.perseus.focus.watch",
  "name": "PerseusFocus",
  "versionName": "1.0.0",
  "versionCode": 1,
  "minPlatformVersion": 1000,
  "icon": "/common/logo.png",
  "deviceTypeList": [
    "watch"
  ],
  "features": [
    {
      "name": "system.router"
    },
    {
      "name": "system.storage"
    },
    {
      "name": "system.fetch"
    }
  ],
  "config": {
    "logLevel": "log",
    "designWidth": "480"
  },
  "router": {
    "entry": "pages/index",
    "pages": {
      "pages/index": {
        "component": "index"
      },
      "pages/timer": {
        "component": "timer"
      },
      "pages/stats": {
        "component": "stats"
      },
      "pages/plan": {
        "component": "plan"
      },
      "pages/sync": {
        "component": "sync"
      }
    }
  }
}
