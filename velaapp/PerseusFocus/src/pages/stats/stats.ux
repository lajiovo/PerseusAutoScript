  font-size: 14px;
  font-weight: bold;
  color: #38bdf8;
  text-align: center;
}

.summary-card {
  width: 360px;
  height: 44px;
  background-color: #1e293b;
  border-radius: 10px;
  flex-direction: row;
  justify-content: space-between;
  align-items: center;
  padding: 0 12px;
  margin-bottom: 6px;
}

.summary-label {
  font-size: 13px;
  color: #94a3b8;
}

.summary-value {
  font-size: 16px;
  font-weight: bold;
  color: #38bdf8;
}

.section-title {
  font-size: 12px;
  color: #94a3b8;
  align-self: flex-start;
  margin-left: 8px;
  margin-bottom: 4px;
}

.list-container {
  flex-direction: column;
  width: 360px;
  height: 200px;
}

.stat-item {
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 5px;
  width: 360px;
}

.sub-name {
  font-size: 13px;
  color: #f8fafc;
  width: 45px;
  font-weight: bold;
}

.bar-bg {
  width: 150px;
  height: 8px;
  background-color: #334155;
  border-radius: 4px;
  overflow: hidden;
}

.bar-fill {
