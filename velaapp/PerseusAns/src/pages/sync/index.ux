<template>
  <div class="container">
    <text class="title">增量同步中心</text>
    <text class="status-text">{{syncStatus}}</text>
    <input class="btn" type="button" value="开始同步" onclick="startSync" />
    <input class="btn-back" type="button" value="返回" onclick="goBack" />
  </div>
</template>

<script>
import router from "@system.router"
import storage from "@system.storage"
import fetch from "@system.fetch"
import prompt from "@system.prompt"

export default {
  private: {
    syncStatus: "点击下方按钮开始同步任务队列...",
    isSyncing: false // 并发锁，防止重复点击
  },

  /**
   * 安全解析 JSON 字符串
   * 自动去除 BOM (\ufeff) 以及两端空白，兼容对象直接传入
   */
  safeParseJson(rawData) {
    if (typeof rawData === 'object' && rawData !== null) {
      return rawData;
    }
    if (typeof rawData !== 'string') {
      throw new Error(`Invalid data type: ${typeof rawData}`);
    }
    // 清理 UTF-8 BOM 头与首尾空格
    const cleaned = rawData.trim().replace(/^\uFEFF/, '');
    return JSON.parse(cleaned);
  },

  /**
   * 递归规范化后端传来的题目 AST 数据，确保符合极简 AST 节点对照表
   */
  normalizeItemAst(node) {
    if (!node) return null;
    if (Array.isArray(node)) {
      const tag = node[0];
      switch (tag) {
        case 't':
          return ['t', String(node[1] || '')];
        case 'r':
          return ['r', (node[1] || []).map(n => this.normalizeItemAst(n))];
        case 'f':
          return ['f', this.normalizeItemAst(node[1]), this.normalizeItemAst(node[2])];
        case 'sq':
          return ['sq', this.normalizeItemAst(node[1])];
        case 'sup_g':
          return ['sup_g', this.normalizeItemAst(node[1]), this.normalizeItemAst(node[2])];
        case 'sub_g':
          return ['sub_g', this.normalizeItemAst(node[1]), this.normalizeItemAst(node[2])];
        case 'vec':
          return ['vec', this.normalizeItemAst(node[1])];
        case 'chem_seq':
          return ['chem_seq', (node[1] || []).map(n => this.normalizeItemAst(n))];
        case 'chem_a':
          return ['chem_a', node[1], this.normalizeItemAst(node[2]), this.normalizeItemAst(node[3])];
        case 'm':
        case 'paragraph':
          return ['m', ...node.slice(1).map(n => this.normalizeItemAst(n))];
        case 'txt':
          return ['t', String(node[1] || '')];
        default:
          return ['t', String(node[1] || '')];
      }
    } else if (typeof node === 'object') {
      // 兼容旧版对象嵌套结构转换为极简数组 AST
      const blockType = node.block_type || node.type;
      if (blockType === 'h1' || blockType === 'h2' || blockType === 'h3') {
        return [blockType, node.raw || node.value || ''];
      }
      if (blockType === 'paragraph' || blockType === 'block_math' || blockType === 'm') {
        const children = node.content || node.children || [];
        return ['m', ...children.map(c => this.normalizeItemAst(c))];
      }
      if (blockType === 'fraction') {
        return ['f', this.normalizeItemAst(node.numerator), this.normalizeItemAst(node.denominator)];
      }
      if (blockType === 'sqrt') {
        return ['sq', this.normalizeItemAst(node.content)];
      }
      if (blockType === 'sup') {
        return ['sup_g', this.normalizeItemAst(node.base), this.normalizeItemAst(node.value)];
      }
      if (blockType === 'sub') {
        return ['sub_g', this.normalizeItemAst(node.base), this.normalizeItemAst(node.value)];
      }
      if (blockType === 'text') {
        return ['t', node.value || ''];
      }
      if (blockType === 'bold') {
        return ['t', node.value || '']; // 或者保留标记，根据reader支持情况
      }
      return ['t', node.raw || node.value || ''];
    }
    return ['t', String(node)];
  },

  /**
   * 清洗整篇题目的多页/多区块数据
   */
  processAnsItemData(ansItem) {
    if (!ansItem.id && ansItem.ans_id) {
      ansItem.id = ansItem.ans_id;
    }
    // 适配并清洗 pages 数据结构
    if (ansItem.pages && Array.isArray(ansItem.pages)) {
      ansItem.pages = ansItem.pages.map(page => {
        let rawBlocks = page.blocks || page;
        if (!Array.isArray(rawBlocks)) rawBlocks = [rawBlocks];
        return {
          blocks: rawBlocks.map(block => {
            // 如果已经是数组且符合极简规范，直接标准化内部；如果是对象则转换
            return this.normalizeItemAst(block);
          })
        };
      });
    } else {
      // 容灾：如果没有pages，默认包装一页
      ansItem.pages = [{
        blocks: [
          ['h1', ansItem.title || '题目解析'],
          ['m', ['t', ansItem.content || '暂无详细内容']]
        ]
      }];
    }
    ansItem.total_pages = ansItem.pages.length;
    return ansItem;
  },
  
  startSync() {
    if (this.isSyncing) {
      console.log("[Sync] 正在同步中，忽略重复触发");
      prompt.showToast({ message: "正在同步中，请稍候..." });
      return;
    }

    this.isSyncing = true;
    this.syncStatus = "正在获取同步任务队列...";
    console.log("[Sync] === 开始同步任务队列 ===");
    
    fetch.fetch({
      url: "http://192.168.10.3:25566/watch/pans/tasks",
      success: (response) => {
        console.log("[Sync] 获取任务队列原始响应 response.data:", response.data);
        try {
          let data = this.safeParseJson(response.data);
          let tasks = data.tasks || [];
          console.log(`[Sync] 成功解析任务队列，任务数量: ${tasks.length}`, tasks);

          if (tasks.length === 0) {
            this.syncStatus = "当前没有待同步任务";
            prompt.showToast({ message: "已经是最新状态" });
            this.isSyncing = false;
            return;
          }
          this.syncStatus = `获取到 ${tasks.length} 个任务，开始依次执行...`;
          this.processTaskQueue(tasks, 0);
        } catch(e) {
          console.error("[Sync] 解析任务队列失败 Error:", e.message, "原始数据:", response.data);
          this.syncStatus = `解析任务队列失败: ${e.message}`;
          this.isSyncing = false;
        }
      },
      fail: (data, code) => {
        console.error(`[Sync] 获取任务队列网络请求失败 code:${code}, data:`, data);
        this.syncStatus = "连接服务端失败，请检查网络";
        this.isSyncing = false;
      }
    });
  },

  processTaskQueue(tasks, index, syncedTitles = []) {
    if (index >= tasks.length) {
      console.log("[Sync] === 所有任务同步完成 ===", syncedTitles);
      const summary = syncedTitles.length > 0 ? `同步完成，已同步: ${syncedTitles.join(', ')}` : "所有任务同步完成！";
      this.syncStatus = summary;
      prompt.showToast({ message: summary });
      this.isSyncing = false; // 释放锁
      return;
    }

    let task = tasks[index];
    const taskId = task.id || task.task_id;
    const taskTitle = task.title || task.ans_id;
    console.log(`[Sync] [任务 ${index + 1}/${tasks.length}] 开始处理:`, task);
    this.syncStatus = `正在同步 (${index + 1}/${tasks.length}): ${taskTitle}`;

    if (task.action === "download") {
      const downloadUrl = `http://192.168.10.3:25566/watch/pans/get/${task.ans_id}`;
      console.log(`[Sync] [任务 ${index + 1}] 发起下载请求: ${downloadUrl}`);

      fetch.fetch({
        url: downloadUrl,
        success: (res) => {
          console.log(`[Sync] [任务 ${index + 1}] 下载接口原始返回:`, res.data);
          try {
            let resJson = this.safeParseJson(res.data);
            if (resJson.status === "success" && resJson.data) {
              let ansItem = resJson.data;
              
              // 关键：对下载的题目数据应用极简 AST 规范解析清洗，使其能够被 reader.ux 完美读取
              ansItem = this.processAnsItemData(ansItem);

              console.log(`[Sync] [任务 ${index + 1}] 题目数据解析清洗完毕，准备写入本地存储:`, ansItem.id);
              
              syncedTitles.push(ansItem.title || taskTitle);

              // 保存本地成功后 ACK 并推进队列
              this.saveAndAckTask(taskId, ansItem, () => {
                this.processTaskQueue(tasks, index + 1, syncedTitles);
              });
            } else {
              console.warn(`[Sync] [任务 ${index + 1}] 服务端返回非 success 状态或无 data，直接 ACK 跳过:`, resJson);
              syncedTitles.push(taskTitle);
              this.sendAck(taskId, () => {
                this.processTaskQueue(tasks, index + 1, syncedTitles);
              });
            }
          } catch(e) {
            console.error(`[Sync] [任务 ${index + 1}] 详情解析 JSON 失败 Error:`, e.message, "原始文本:", res.data);
            syncedTitles.push(taskTitle);
            this.sendAck(taskId, () => {
              this.processTaskQueue(tasks, index + 1, syncedTitles);
            });
          }
        },
        fail: (data, code) => {
          console.error(`[Sync] [任务 ${index + 1}] 获取题目 ${task.ans_id} 网络失败 code:${code}，1.5s 后重试`);
          this.syncStatus = `获取题目 ${task.ans_id} 详情失败，将在 1.5 秒后重试`;
          setTimeout(() => { 
            this.processTaskQueue(tasks, index, syncedTitles); 
          }, 1500);
        }
      });
    } else {
      console.log(`[Sync] [任务 ${index + 1}] 非下载动作 (${task.action})，直接发送 ACK`);
      syncedTitles.push(taskTitle);
      this.sendAck(taskId, () => {
        this.processTaskQueue(tasks, index + 1, syncedTitles);
      });
    }
  },

  saveAndAckTask(taskId, ansItem, callback) {
    storage.get({
      key: "local_answers",
      success: (data) => {
        let list = [];
        if (data) {
          try {
            list = this.safeParseJson(data);
          } catch(e) {
            console.error("[Storage] 本地 local_answers 损坏，初始化为空数组", e);
          }
        }
        
        const targetId = String(ansItem.id);
        const originalLen = list.length;
        list = list.filter(i => String(i.id || i.ans_id) !== targetId);
        list.push(ansItem);

        console.log(`[Storage] 更新本地存储，原条数:${originalLen} -> 现条数:${list.length}`);

        storage.set({
          key: "local_answers",
          value: JSON.stringify(list),
          success: () => {
            console.log(`[Storage] 写入本地存储成功，开始 ACK 任务: ${taskId}`);
            this.sendAck(taskId, callback);
          },
          fail: (data, code) => {
            console.error(`[Storage] 写入本地存储失败 code:${code}, data:`, data);
            if (callback) callback();
          }
        });
      },
      fail: (data, code) => {
        console.warn(`[Storage] 读取 local_answers 失败 code:${code}，直接创建新数据`);
        let list = [ansItem];
        storage.set({
          key: "local_answers",
          value: JSON.stringify(list),
          success: () => {
            this.sendAck(taskId, callback);
          },
          fail: () => {
            if (callback) callback();
          }
        });
      }
    });
  },

  sendAck(taskId, callback) {
    if (!taskId) {
      console.warn("[ACK] 缺少 taskId，跳过 ACK");
      if (callback) callback();
      return;
    }
    
    console.log(`[ACK] 向服务端发送 ACK 确认: ${taskId}`);
    fetch.fetch({
      url: "http://192.168.10.3:25566/watch/pans/task/ack",
      method: "POST",
      data: JSON.stringify({ task_id: taskId }),
      header: { "Content-Type": "application/json" },
      success: (response) => {
        console.log(`[ACK] 任务 ${taskId} ACK 成功 response:`, response.data);
        if (callback) callback();
      },
      fail: (data, code) => {
        console.error(`[ACK] 任务 ${taskId} ACK 请求网络失败 code:${code}，继续推进队列`);
        if (callback) callback();
      }
    });
  },

  goBack() {
    router.back();
  }
}
</script>

<style>
.container {
  flex-direction: column;
  background-color: #000000;
  width: 100%;
  height: 100%;
  padding: 20px;
  align-items: center;
  justify-content: center;
}
.title {
  font-size: 16px;
  color: #ffffff;
  font-weight: bold;
  margin-bottom: 20px;
}
.status-text {
  font-size: 13px;
  color: #00ff00;
  margin-bottom: 20px;
  text-align: center;
}
.btn {
  width: 150px;
  height: 35px;
  background-color: #007bff;
  color: #ffffff;
  font-size: 14px;
  border-radius: 4px;
  margin-bottom: 10px;
}
.btn-back {
  width: 150px;
  height: 35px;
  background-color: #333333;
  color: #ffffff;
  font-size: 14px;
  border-radius: 4px;
}
</style>