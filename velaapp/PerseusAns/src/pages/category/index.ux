.container {
  flex-direction: column;
  background-color: #000000;
  width: 100%;
  height: 100%;
  padding: 10px;
  align-items: center;
}
.title {
  font-size: 16px;
  color: #ffffff;
  font-weight: bold;
  margin-bottom: 10px;
}
.list {
  flex: 1;
  width: 100%;
}
.cat-item {
  height: 40px;
  background-color: #1a1a1a;
  border-radius: 6px;
  margin-bottom: 6px;
  justify-content: center;
  align-items: center;
}
.cat-text {
  font-size: 14px;
  color: #007bff;
}
</style>
