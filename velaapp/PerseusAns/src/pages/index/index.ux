<template>
  <div class="container">
    <!-- Top Bar -->
    <div class="top-bar">
      <div class="category-box" onclick="switchCategory">
        <text class="app-title">分类: {{currentCategory}} ▼</text>
      </div>
      <div class="top-btns">
        <input class="sync-btn" type="button" value="刷新" onclick="reloadLocal" />
        <input class="sync-btn" type="button" value="同步" onclick="gotoSync" />
        <input class="settings-btn" type="button" value="设置" onclick="gotoSettings" />
      </div>
    </div>

    <!-- Debug Log Panel -->
    <div class="debug-panel" if="{{debugMode}}">
      <text class="debug-title">[Index Debug Log]</text>
      <text class="debug-text">{{debugLog}}</text>
    </div>

    <!-- Main Content List -->
    <list class="list">
      <list-item type="item" for="{{ansList}}" class="list-item" onclick="gotoReader($item.id)">
        <text class="item-title">[{{$item.category || '数学'}}] {{$item.title || '无标题解析'}}</text>
        <text class="item-summary">{{$item.summary || ('共 ' + ($item.total_pages || 1) + ' 页解析 | ID: ' + $item.id)}}</text>
      </list-item>
    </list>

    <!-- Empty State / Hint if no data -->
    <div class="empty-box" if="{{ansList.length === 0}}">
      <text class="empty-text">暂无解析数据，请前往同步中心拉取</text>
    </div>

  </div>
</template>

<script>
import router from "@system.router"
import storage from "@system.storage"
import prompt from "@system.prompt"

export default {
  private: {
    currentCategory: "全部",
    categories: ["全部", "数学", "物理", "化学", "综合"],
    ansList: [],
    debugMode: false,
    debugLog: "初始化加载..."
  },
  onInit() {
    this.checkDebugAndLoad();
  },
  onShow() {
    this.checkDebugAndLoad();
  },
  checkDebugAndLoad() {
    storage.get({
      key: "debug_mode",
      success: (data) => {
        this.debugMode = (data === "true" || data === true);
        this.loadData();
      },
      fail: () => {
        this.debugMode = false;
        this.loadData();
      }
    });
  },
  logDebug(msg) {
    console.log("[IndexDebug] " + msg);
    if (this.debugMode) {
      this.debugLog = msg + "\n" + (this.debugLog || "");
    }
  },
  loadData() {
    storage.get({
      key: "current_category",
      success: (data) => {
        if (data) {
          this.currentCategory = data;
        } else {
          this.currentCategory = "全部";
        }
        this.loadLocalAnswers();
      },
      fail: () => {
        this.currentCategory = "全部";
        this.loadLocalAnswers();
      }
    });
  },
  loadLocalAnswers() {
    this.logDebug(`开始加载本地缓存 [当前分类: ${this.currentCategory}]`);
    storage.get({
      key: "local_answers",
      success: (data) => {
        if (data) {
          try {
            let cleaned = data.trim().replace(/^\uFEFF/, '');
            let list = JSON.parse(cleaned);
            if (!Array.isArray(list)) list = [];
            
            this.logDebug(`成功读取 local_answers，原始条数: ${list.length}`);

            list = list.map(item => ({
              ...item,
              id: item.id || item.ans_id,
              category: item.category || "数学"
            }));

            if (this.currentCategory !== "全部") {
              const beforeCount = list.length;
              list = list.filter(item => String(item.category).trim() === String(this.currentCategory).trim());
              this.logDebug(`分类过滤 [${this.currentCategory}]: 过滤前 ${beforeCount} 条 -> 过滤后 ${list.length} 条`);
            }

            this.ansList = list;
            this.logDebug(`渲染列表成功，最终条数: ${this.ansList.length}`);
          } catch(e) {
            this.logDebug(`解析 local_answers JSON 失败: ${e.message}`);
            this.ansList = [];
          }
        } else {
          this.logDebug("local_answers 存储为空");
          this.ansList = [];
        }
      },
      fail: (data, code) => {
        this.logDebug(`读取 local_answers 失败 code:${code}`);
        this.ansList = [];
      }
    });
  },
  reloadLocal() {
    prompt.showToast({ message: "正在重新载入本地数据..." });
    this.loadData();
  },
  switchCategory() {
    const idx = this.categories.indexOf(this.currentCategory);
    const nextIdx = (idx + 1) % this.categories.length;
    this.currentCategory = this.categories[nextIdx];
    
    storage.set({
      key: "current_category",
      value: this.currentCategory,
      success: () => {
        prompt.showToast({ message: `已切换分类: ${this.currentCategory}` });
        this.loadLocalAnswers();
      }
    });
  },
  gotoSettings() {
    router.push({ uri: "/pages/settings" });
  },
  gotoSync() {
    router.push({ uri: "/pages/sync" });
  },
  gotoReader(id) {
    if (!id) return;
    router.push({ uri: "/pages/reader", params: { ansId: String(id) } });
  }
}
</script>

<style>
.container {
  flex-direction: column;
  background-color: #000000;
  width: 100%;
  height: 100%;
  padding: 10px;
}
.top-bar {
  flex-direction: row;
  justify-content: space-between;
  align-items: center;
  height: 40px;
  border-bottom-width: 1px;
  border-bottom-color: #333333;
}
.category-box {
  flex: 1;
  height: 40px;
  justify-content: center;
}
.app-title {
  font-size: 12px;
  color: #ffaa00;
  font-weight: bold;
}
.top-btns {
  flex-direction: row;
  align-items: center;
}
.sync-btn {
  width: 36px;
  height: 28px;
  background-color: #007bff;
  color: #ffffff;
  font-size: 11px;
  border-radius: 4px;
  margin-right: 4px;
}
.settings-btn {
  width: 36px;
  height: 28px;
  background-color: #333333;
  color: #ffffff;
  font-size: 11px;
  border-radius: 4px;
}
.debug-panel {
  width: 100%;
  height: 80px;
  background-color: #1a1a1a;
  border-radius: 4px;
  padding: 6px;
  margin-top: 6px;
  flex-direction: column;
}
.debug-title {
  font-size: 10px;
  color: #ffaa00;
  font-weight: bold;
}
.debug-text {
  font-size: 9px;
  color: #cccccc;
}
.list {
  flex: 1;
  margin-top: 8px;
}
.list-item {
  flex-direction: column;
  padding: 10px;
  background-color: #1a1a1a;
  border-radius: 6px;
  margin-bottom: 8px;
}
.item-title {
  font-size: 14px;
  color: #ffaa00;
  font-weight: bold;
}
.item-summary {
  font-size: 11px;
  color: #aaaaaa;
  margin-top: 4px;
}
.empty-box {
  flex: 1;
  justify-content: center;
  align-items: center;
}
.empty-text {
  font-size: 12px;
  color: #666666;
  text-align: center;
}
</style>
