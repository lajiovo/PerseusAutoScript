<template>
  <div class="container">
    <text class="title">选择科目分类</text>
    <list class="list">
      <list-item type="cat" for="{{categories}}" class="cat-item" onclick="selectCategory($item)">
        <text class="cat-text">{{$item}}</text>
      </list-item>
    </list>
  </div>
</template>

<script>
import router from "@system.router"
import storage from "@system.storage"

export default {
  private: {
    categories: [
      "全部", "语文", "数学", "英语", "物理", 
      "化学", "生物", "历史", "地理", "政治"
    ]
  },
  selectCategory(cat) {
    storage.set({
      key: "current_category",
      value: cat,
      success: () => {
        router.back();
      },
      fail: () => {
        router.back();
      }
    });
  }
}
</script>

