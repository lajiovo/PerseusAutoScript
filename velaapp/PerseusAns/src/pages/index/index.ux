.container {
  flex-direction: column;
  background-color: #000000;
  width: 100%;
  height: 100%;
  padding: 10px;
}
.top-bar {
  flex-direction: row;
  justify-content: space-between;
  align-items: center;
  height: 40px;
  border-bottom-width: 1px;
  border-bottom-color: #333333;
}
.app-title {
  font-size: 14px;
  color: #ffffff;
  font-weight: bold;
}
.top-btns {
  flex-direction: row;
  align-items: center;
}
.sync-btn {
  width: 42px;
  height: 28px;
  background-color: #007bff;
  color: #ffffff;
  font-size: 11px;
  border-radius: 4px;
  margin-right: 6px;
}
.settings-btn {
  width: 42px;
  height: 28px;
  background-color: #333333;
  color: #ffffff;
  font-size: 11px;
  border-radius: 4px;
}
.list {
  flex: 1;
  margin-top: 10px;
}
.list-item {
  flex-direction: column;
  padding: 10px;
  background-color: #1a1a1a;
  border-radius: 6px;
  margin-bottom: 8px;
}
.item-title {
  font-size: 14px;
  color: #ffaa00;
  font-weight: bold;
}
.item-summary {
  font-size: 11px;
  color: #aaaaaa;
  margin-top: 4px;
}
.empty-box {
  flex: 1;
  justify-content: center;
  align-items: center;
}
.empty-text {
  font-size: 12px;
  color: #666666;
  text-align: center;
}
.fab-btn {
  position: fixed;
  right: 15px;
  bottom: 15px;
  width: 45px;
  height: 45px;
  border-radius: 22px;
  background-color: #007bff;
  color: #ffffff;
  font-size: 13px;
}
</style>