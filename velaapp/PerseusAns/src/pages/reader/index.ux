<template>
  <div class="container">
    <!-- Top Fixed Bar -->
    <div class="top-bar">
      <text class="title">{{ansTitle}}</text>
      <text class="page-indicator">{{currentPage + 1}}/{{totalPages}}</text>
    </div>

    <!-- Main Content Container with Horizontal Scroll Support -->
    <scroll class="reader-scroll" scroll-x="true" scroll-y="true">
      <div class="content-body" id="contentBody">
        <!-- Rendered paragraphs and AST nodes -->
        <block for="{{pageNodes}}">
          <text class="h1" if="{{$item.type === 'h1'}}">{{$item.value}}</text>
          <text class="h2" if="{{$item.type === 'h2'}}">{{$item.value}}</text>
          <text class="h3" if="{{$item.type === 'h3'}}">{{$item.value}}</text>
          <div class="paragraph" if="{{$item.type === 'paragraph'}}">
            <block for="{{$item.children}}">
              <text class="text" if="{{$item.type === 'text'}}">{{$item.value}}</text>
              <!-- Fraction AST -->
              <div class="ast-fraction" if="{{$item.type === 'formula_inline' && $item.ast.type === 'fraction'}}">
                <text class="ast-num">{{$item.ast.numerator.value}}</text>
                <line class="ast-line"></line>
                <text class="ast-den">{{$item.ast.denominator.value}}</text>
              </div>
              <!-- Sqrt AST -->
              <div class="ast-sqrt" if="{{$item.type === 'formula_inline' && $item.ast.type === 'sqrt'}}">
                <text class="ast-symbol">√</text>
                <text class="ast-sqrt-text">{{$item.ast.content.value}}</text>
              </div>
              <!-- Generic formula fallback -->
              <text class="formula-text" if="{{$item.type === 'formula_inline' && !$item.ast.type}}">[公式]</text>
            </block>
          </div>
        </block>
      </div>
    </scroll>

    <!-- Bottom Fixed Bar -->
    <div class="bottom-bar">
      <input class="btn" type="button" value="上一页" onclick="prevPage" />
      <input class="btn" type="button" value="下一页" onclick="nextPage" />
      <input class="btn-danger" type="button" value="删除" onclick="confirmDelete" />
    </div>
  </div>
</template>

<script>
import router from "@system.router"
import storage from "@system.storage"
import prompt from "@system.prompt"

export default {
  private: {
    ansId: null,
    ansTitle: "",
    totalPages: 1,
    currentPage: 0,
    pagesData: [],
    pageNodes: []
  },
  onInit(params) {
    this.ansId = params.ansId;
    this.loadAnswerData();
  },
  loadAnswerData() {
    storage.get({
      key: "local_answers",
      success: (data) => {
        if (data) {
          try {
            let list = JSON.parse(data);
            let item = list.find(i => String(i.id) === String(this.ansId));
            if (item) {
              this.ansTitle = item.title;
              this.totalPages = item.total_pages || 1;
              this.pagesData = item.pages || [];
              this.updatePageContent();
            }
          } catch(e) {}
        }
      }
    });
  },
  updatePageContent() {
    if (this.pagesData && this.pagesData.length > this.currentPage) {
      this.pageNodes = this.pagesData[this.currentPage];
    }
  },
  prevPage() {
    if (this.currentPage > 0) {
      this.currentPage--;
      this.updatePageContent();
    }
  },
  nextPage() {
    if (this.currentPage < this.totalPages - 1) {
      this.currentPage++;
      this.updatePageContent();
    }
  },
  confirmDelete() {
    prompt.showDialog({
      title: "确认删除",
      message: "是否删除该题目解析？",
      buttons: [
        { text: "取消", color: "#666666" },
        { text: "删除", color: "#ff0000" }
      ],
      success: (data) => {
        if (data.index === 1) {
          storage.get({
            key: "local_answers",
            success: (sData) => {
              if (sData) {
                let list = JSON.parse(sData);
                list = list.filter(i => String(i.id) !== String(this.ansId));
                storage.set({
                  key: "local_answers",
                  value: JSON.stringify(list),
                  success: () => {
                    prompt.showToast({ message: "已删除" });
                    router.back();
                  }
                });
              }
            }
          });
        }
      }
    });
  }
}
</script>

<style>
.container {
  flex-direction: column;
  background-color: #000000;
  width: 100%;
  height: 100%;
  padding: 8px;
}
.top-bar {
  flex-direction: row;
  justify-content: space-between;
  align-items: center;
  height: 35px;
  border-bottom-width: 1px;
  border-bottom-color: #333333;
}
.title {
  font-size: 14px;
  color: #ffaa00;
  font-weight: bold;
}
.page-indicator {
  font-size: 12px;
  color: #aaaaaa;
}
.reader-scroll {
  flex: 1;
  margin-top: 5px;
  margin-bottom: 5px;
}
.content-body {
  flex-direction: column;
  padding: 5px;
}
.h1 {
  font-size: 18px;
  font-weight: bold;
  color: #ffffff;
  margin-bottom: 6px;
}
.h2 {
  font-size: 16px;
  font-weight: bold;
  color: #ffffff;
  margin-bottom: 5px;
}
.h3 {
  font-size: 14px;
  font-weight: bold;
  color: #ffffff;
  margin-bottom: 4px;
}
.paragraph {
  flex-direction: row;
  flex-wrap: wrap;
  margin-bottom: 6px;
}
.text {
  font-size: 13px;
  color: #e0e0e0;
}
.ast-fraction {
  flex-direction: column;
  align-items: center;
  margin: 0 4px;
}
.ast-num {
  font-size: 11px;
  color: #00ffff;
  border-bottom-width: 1px;
  border-bottom-color: #00ffff;
  padding-bottom: 1px;
}
.ast-den {
  font-size: 11px;
  color: #00ffff;
  padding-top: 1px;
}
.ast-sqrt {
  flex-direction: row;
  align-items: center;
  margin: 0 4px;
}
.ast-symbol {
  font-size: 14px;
  color: #ff00ff;
}
.ast-sqrt-text {
  font-size: 12px;
  color: #ff00ff;
  border-top-width: 1px;
  border-top-color: #ff00ff;
  padding-top: 1px;
}
.bottom-bar {
  flex-direction: row;
  justify-content: space-between;
  height: 35px;
  align-items: center;
}
.btn {
  width: 90px;
  height: 30px;
  background-color: #333333;
  color: #ffffff;
  font-size: 12px;
  border-radius: 4px;
}
.btn-danger {
  width: 70px;
  height: 30px;
  background-color: #aa0000;
  color: #ffffff;
  font-size: 12px;
  border-radius: 4px;
}
</style>
