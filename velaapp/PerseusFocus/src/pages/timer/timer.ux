  justify-content: center;
  align-items: center;
}

.tab-btn {
  width: 140px;
  height: 36px;
  text-align: center;
  font-size: 16px;
  color: #94a3b8;
  border-radius: 18px;
}

.active-tab {
  background-color: #38bdf8;
  color: #0f172a;
  font-weight: bold;
}

.mode-box {
  flex-direction: column;
  align-items: center;
  width: 440px;
  height: 180px;
  justify-content: center;
}

.timer-display {
  font-size: 40px;
