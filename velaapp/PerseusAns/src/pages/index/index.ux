  flex-direction: row;
  align-items: center;
}
.icon-btn {
  width: 38px;
  height: 26px;
  background-color: #243044;
  color: #dce3f0;
  font-size: 10px;
  border-radius: 13px;
  margin-left: 4px;
}
.accent {
  background-color: #d97706;
  color: #ffffff;
}
.ghost {
  background-color: #1a1f2b;
}
.stats-row {
  margin-top: 6px;
  margin-bottom: 4px;
}
.stats-text {
  font-size: 10px;
  color: #7d8699;
}
.debug-panel {
  width: 100%;
  height: 72px;
  background-color: #141821;
  border-radius: 8px;
  padding: 6px;
  margin-bottom: 6px;
  flex-direction: column;
}
.debug-fullscreen {
  position: absolute;
  left: 0;
  top: 40px;
  width: 100%;
  height: 90%;
  background-color: #0f1218;
  z-index: 999;
  padding: 10px;
}
.debug-header {
  flex-direction: row;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 4px;
}
.debug-title {
  font-size: 10px;
  color: #f5c15d;
  font-weight: bold;
}
.debug-toggle-btn {
  width: 40px;
  height: 20px;
  background-color: #7f1d1d;
  color: #ffffff;
  font-size: 9px;
  border-radius: 10px;
}
.debug-scroll {
  flex: 1;
}
.debug-text {
  font-size: 9px;
  color: #b7c0d1;
}
.list {
  flex: 1;
  margin-top: 2px;
}
.list-item {
  flex-direction: row;
  padding: 0px;
  background-color: #151a24;
  border-radius: 10px;
  margin-bottom: 8px;
}
.item-accent {
  width: 4px;
  background-color: #f5c15d;
  border-radius: 10px 0px 0px 10px;
}
.item-body {
  flex: 1;
  flex-direction: column;
  padding: 8px 10px;
}
.item-head {
  flex-direction: row;
  align-items: center;
  margin-bottom: 2px;
}
.item-cat {
  font-size: 9px;
  color: #93c5fd;
}
.item-flag {
  font-size: 9px;
  color: #fca5a5;
  margin-left: 6px;
}
.item-title {
  font-size: 14px;
  color: #f3f5f8;
  font-weight: bold;
}
.item-summary {
  font-size: 11px;
  color: #9aa3b5;
  margin-top: 3px;
  lines: 2;
  text-overflow: ellipsis;
}
.empty-box {
  flex: 1;
  justify-content: center;
  align-items: center;
  padding: 12px;
}
.empty-title {
  font-size: 14px;
  color: #e5e7eb;
