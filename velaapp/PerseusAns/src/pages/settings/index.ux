<template>
  <div class="container">
    <text class="title">系统设置与存储</text>
    
    <div class="menu-item" onclick="gotoSync">
      <text class="menu-text">数据增量同步</text>
    </div>
    
    <div class="menu-item" onclick="clearCache">
      <text class="menu-text">一键清空本地题目缓存</text>
    </div>

    <div class="menu-item">
      <text class="menu-text">公式字号调整 (当前: 14px)</text>
    </div>
  </div>
</template>

<script>
import router from "@system.router"
import storage from "@system.storage"
import prompt from "@system.prompt"

export default {
  gotoSync() {
    router.push({ uri: "/pages/sync" });
  },
  clearCache() {
    prompt.showDialog({
      title: "确认清空",
      message: "是否清空所有本地存储的题目解析缓存？",
      buttons: [
        { text: "取消", color: "#666666" },
        { text: "确定", color: "#ff0000" }
      ],
      success: (data) => {
        if (data.index === 1) {
          storage.delete({
            key: "local_answers",
            success: () => {
              prompt.showToast({ message: "已清空本地缓存" });
            },
            fail: () => {
              prompt.showToast({ message: "清空失败" });
            }
          });
        }
      }
    });
  }
}
</script>

<style>
.container {
  flex-direction: column;
  background-color: #000000;
  width: 100%;
  height: 100%;
  padding: 15px;
}
.title {
  font-size: 16px;
  color: #ffffff;
  font-weight: bold;
  margin-bottom: 15px;
  text-align: center;
}
.menu-item {
  height: 45px;
  background-color: #1a1a1a;
  border-radius: 6px;
  margin-bottom: 10px;
  justify-content: center;
  padding-left: 15px;
}
.menu-text {
  font-size: 14px;
  color: #ffffff;
}
</style>
