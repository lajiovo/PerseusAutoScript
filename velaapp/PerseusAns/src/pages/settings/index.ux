<template>
  <div class="container">
    <text class="title">系统设置与存储 (Debug)</text>
    
    <!-- Data Sync Menu -->
    <div class="menu-item" onclick="gotoSync">
      <text class="menu-text">数据增量同步</text>
    </div>
    
    <!-- Debug Mode Toggle -->
    <div class="menu-item" onclick="toggleDebug">
      <text class="menu-text">Debug 模式: {{debugMode ? '已开启' : '已关闭'}}</text>
    </div>

    <!-- View Local Database (Storage Viewer) -->
    <div class="menu-item" onclick="viewDatabase">
      <text class="menu-text">查看本地数据库 (local_answers)</text>
    </div>

    <!-- Clear Cache Menu -->
    <div class="menu-item" onclick="clearCache">
      <text class="menu-text">一键清空本地题目缓存</text>
    </div>

    <!-- Font Size Adjustment Menu -->
    <div class="menu-item" onclick="changeFontSize">
      <text class="menu-text">公式字号调整 (当前: {{fontSize}}px)</text>
    </div>

    <!-- Back Button -->
    <input class="btn-back" type="button" value="返回" onclick="goBack" />
  </div>
</template>

<script>
import router from "@system.router"
import storage from "@system.storage"
import prompt from "@system.prompt"

export default {
  private: {
    fontSize: 14,
    debugMode: false
  },
  onInit() {
    this.loadSettings();
  },
  loadSettings() {
    storage.get({
      key: "reader_font_size",
      success: (data) => {
        if (data) {
          let size = parseInt(data, 10);
          if (!isNaN(size)) {
            this.fontSize = size;
          }
        }
      }
    });
    storage.get({
      key: "debug_mode",
      success: (data) => {
        this.debugMode = (data === "true" || data === true);
      }
    });
  },
  toggleDebug() {
    this.debugMode = !this.debugMode;
    storage.set({
      key: "debug_mode",
      value: String(this.debugMode),
      success: () => {
        prompt.showToast({ message: `Debug 模式已${this.debugMode ? '开启' : '关闭'}` });
      }
    });
  },
  viewDatabase() {
    storage.get({
      key: "local_answers",
      success: (data) => {
        if (!data) {
          prompt.showToast({ message: "本地数据库为空" });
          return;
        }
        try {
          let parsed = JSON.parse(data);
          let count = Array.isArray(parsed) ? parsed.length : 0;
          let titles = Array.isArray(parsed) ? parsed.map(i => i.title || i.ans_id).join(', ') : "非数组数据";
          prompt.showDialog({
            title: "本地数据库查看",
            message: `题目总数: ${count}\n\n题目列表: ${titles}`,
            buttons: [{ text: "确定", color: "#007bff" }]
          });
        } catch(e) {
          prompt.showDialog({
            title: "数据库解析错误",
            message: String(data).substring(0, 200),
            buttons: [{ text: "确定", color: "#ff0000" }]
          });
        }
      },
      fail: () => {
        prompt.showToast({ message: "读取本地数据库失败" });
      }
    });
  },
  gotoSync() {
    router.push({ uri: "/pages/sync" });
  },
  changeFontSize() {
    const sizes = [12, 14, 16];
    let nextIndex = (sizes.indexOf(this.fontSize) + 1) % sizes.length;
    this.fontSize = sizes[nextIndex];

    storage.set({
      key: "reader_font_size",
      value: String(this.fontSize),
      success: () => {
        prompt.showToast({ message: `字号已设为 ${this.fontSize}px` });
      }
    });
  },
  clearCache() {
    prompt.showDialog({
      title: "确认清空",
      message: "是否清空所有本地存储的题目解析缓存及分类状态？",
      buttons: [
        { text: "取消", color: "#666666" },
        { text: "确定", color: "#ff0000" }
      ],
      success: (data) => {
        if (data.index === 1) {
          storage.delete({
            key: "local_answers",
            success: () => {
              storage.delete({ key: "current_category" });
              prompt.showToast({ message: "已清空本地缓存" });
            },
            fail: () => {
              prompt.showToast({ message: "清空失败" });
            }
          });
        }
      }
    });
  },
  goBack() {
    router.back();
  }
}
</script>

<style>
.container {
  flex-direction: column;
  background-color: #000000;
  width: 100%;
  height: 100%;
  padding: 15px;
}
.title {
  font-size: 15px;
  color: #ffffff;
  font-weight: bold;
  margin-bottom: 12px;
  text-align: center;
}
.menu-item {
  height: 42px;
  background-color: #1a1a1a;
  border-radius: 6px;
  margin-bottom: 8px;
  justify-content: center;
  padding-left: 12px;
}
.menu-text {
  font-size: 13px;
  color: #ffffff;
}
.btn-back {
  width: 100%;
  height: 35px;
  background-color: #333333;
  color: #ffffff;
  font-size: 13px;
  border-radius: 6px;
  margin-top: 10px;
}
</style>
