  margin-bottom: 5px;
}

.list-container {
  flex-direction: column;
  width: 440px;
  height: 220px;
}

.analysis-item {
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
  background-color: #1e293b;
  height: 38px;
  border-radius: 8px;
  padding: 0 12px;
  margin-bottom: 6px;
  width: 440px;
}

