<template>
  <div class="container">
    <text class="title">增量同步中心</text>
    <text class="status-text">{{syncStatus}}</text>
    <input class="btn" type="button" value="开始同步" onclick="startSync" />
    <input class="btn-back" type="button" value="返回" onclick="goBack" />
  </div>
</template>

<script>
import router from "@system.router"
import storage from "@system.storage"
import fetch from "@system.fetch"
import prompt from "@system.prompt"

export default {
  private: {
    syncStatus: "点击下方按钮开始同步任务队列..."
  },
  startSync() {
    this.syncStatus = "正在获取同步任务队列...";
    fetch.fetch({
      url: "http://192.168.10.3:25566/watch/ans/tasks",
      success: (response) => {
        try {
          let data = JSON.parse(response.data);
          let tasks = data.tasks || [];
          if (tasks.length === 0) {
            this.syncStatus = "当前没有待同步任务";
            prompt.showToast({ message: "已经是最新状态" });
            return;
          }
          this.syncStatus = `获取到 ${tasks.length} 个任务，开始依次执行...`;
          this.processTaskQueue(tasks, 0);
        } catch(e) {
          this.syncStatus = "解析任务队列失败";
        }
      },
      fail: () => {
        this.syncStatus = "连接服务端失败，请检查网络";
      }
    });
  },
  processTaskQueue(tasks, index) {
    if (index >= tasks.length) {
      this.syncStatus = "所有任务同步完成！";
      prompt.showToast({ message: "同步成功" });
      return;
    }

    let task = tasks[index];
    this.syncStatus = `正在同步 (${index + 1}/${tasks.length}): ${task.title || task.ans_id}`;

    if (task.action === "download") {
      fetch.fetch({
        url: `http://192.168.10.3:25566/watch/ans/get/${task.ans_id}`,
        success: (res) => {
          try {
            let resJson = JSON.parse(res.data);
            if (resJson.status === "success") {
              let ansItem = resJson.data;
              this.saveAndAckTask(task.task_id, ansItem, () => {
                this.processTaskQueue(tasks, index + 1);
              });
            } else {
              this.processTaskQueue(tasks, index + 1);
            }
          } catch(e) {
            this.processTaskQueue(tasks, index + 1);
          }
        },
        fail: () => {
          this.syncStatus = `获取题目 ${task.ans_id} 详情失败，重试/跳过`;
          setTimeout(() => { this.processTaskQueue(tasks, index + 1); }, 1500);
        }
      });
    } else {
      // 其它动作直接 ACK
      this.sendAck(task.task_id, () => {
        this.processTaskQueue(tasks, index + 1);
      });
    }
  },
  saveAndAckTask(taskId, ansItem, callback) {
    storage.get({
      key: "local_answers",
      success: (data) => {
        let list = [];
        if (data) {
          try { list = JSON.parse(data); } catch(e) {}
        }
        // 去重更新
        list = list.filter(i => i.id !== ansItem.id);
        list.push(ansItem);
        
        storage.set({
          key: "local_answers",
          value: JSON.stringify(list),
          success: () => {
            this.sendAck(taskId, callback);
          },
          fail: () => {
            callback();
          }
        });
      },
      fail: () => {
        let list = [ansItem];
        storage.set({
          key: "local_answers",
          value: JSON.stringify(list),
          success: () => {
            this.sendAck(taskId, callback);
          }
        });
      }
    });
  },
  sendAck(taskId, callback) {
    fetch.fetch({
      url: "http://192.168.10.3:25566/watch/ans/task/ack",
      method: "POST",
      data: JSON.stringify({ task_id: taskId }),
      header: { "Content-Type": "application/json" },
      success: () => {
        if (callback) callback();
      },
      fail: () => {
        if (callback) callback();
      }
    });
  },
  goBack() {
    router.back();
  }
}
</script>

<style>
.container {
  flex-direction: column;
  background-color: #000000;
  width: 100%;
  height: 100%;
  padding: 20px;
  align-items: center;
  justify-content: center;
}
.title {
  font-size: 16px;
  color: #ffffff;
  font-weight: bold;
  margin-bottom: 20px;
}
.status-text {
  font-size: 13px;
  color: #00ff00;
  margin-bottom: 20px;
  text-align: center;
}
.btn {
  width: 150px;
  height: 35px;
  background-color: #007bff;
  color: #ffffff;
  font-size: 14px;
  border-radius: 4px;
  margin-bottom: 10px;
}
.btn-back {
  width: 150px;
  height: 35px;
  background-color: #333333;
  color: #ffffff;
  font-size: 14px;
  border-radius: 4px;
}
</style>
