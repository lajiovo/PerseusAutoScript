<template>
  <div class="container">
    <!-- Top Bar -->
    <div class="top-bar">
      <text class="app-title">Perseus 解析 ({{currentCategory}})</text>
      <input class="settings-btn" type="button" value="设置" onclick="gotoSettings" />
    </div>

    <!-- Main Content List -->
    <list class="list">
      <list-item type="item" for="{{ansList}}" class="list-item" onclick="gotoReader($item.id)">
        <text class="item-title">[{{$item.category}}] {{$item.title}}</text>
        <text class="item-summary">{{$item.summary}}</text>
      </list-item>
    </list>

    <!-- Floating Category Button -->
    <input class="fab-btn" type="button" value="分类" onclick="gotoCategory" />
  </div>
</template>

<script>
import router from "@system.router"
import storage from "@system.storage"

export default {
  private: {
    currentCategory: "全部",
    ansList: []
  },
  onInit() {
    storage.get({
      key: "current_category",
      success: (data) => {
        if (data) {
          this.currentCategory = data;
        }
        this.loadLocalAnswers();
      },
      fail: () => {
        this.loadLocalAnswers();
      }
    });
  },
  loadLocalAnswers() {
    storage.get({
      key: "local_answers",
      success: (data) => {
        if (data) {
          try {
            let list = JSON.parse(data);
            if (this.currentCategory !== "全部") {
              list = list.filter(item => item.category === this.currentCategory);
            }
            this.ansList = list;
          } catch(e) {
            this.ansList = [];
          }
        }
      },
      fail: () => {
        this.ansList = [];
      }
    });
  },
  gotoSettings() {
    router.push({ uri: "/pages/settings" });
  },
  gotoCategory() {
    router.push({ uri: "/pages/category" });
  },
  gotoReader(id) {
    router.push({ uri: "/pages/reader", params: { ansId: id } });
  }
}
</script>

<style>
.container {
  flex-direction: column;
  background-color: #000000;
  width: 100%;
  height: 100%;
  padding: 10px;
}
.top-bar {
  flex-direction: row;
  justify-content: space-between;
  align-items: center;
  height: 40px;
  border-bottom-width: 1px;
  border-bottom-color: #333333;
}
.app-title {
  font-size: 16px;
  color: #ffffff;
  font-weight: bold;
}
.settings-btn {
  width: 50px;
  height: 30px;
  background-color: #333333;
  color: #ffffff;
  font-size: 12px;
  border-radius: 4px;
}
.list {
  flex: 1;
  margin-top: 10px;
}
.list-item {
  flex-direction: column;
  padding: 10px;
  background-color: #1a1a1a;
  border-radius: 6px;
  margin-bottom: 8px;
}
.item-title {
  font-size: 15px;
  color: #ff9900;
  font-weight: bold;
}
.item-summary {
  font-size: 12px;
  color: #cccccc;
  margin-top: 4px;
}
.fab-btn {
  position: fixed;
  right: 15px;
  bottom: 15px;
  width: 50px;
  height: 50px;
  border-radius: 25px;
  background-color: #007bff;
  color: #ffffff;
  font-size: 14px;
}
</style>
