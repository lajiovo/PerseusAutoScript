<template>
  <div class="container">
    <text class="title">设置</text>

    <div class="menu-item" onclick="gotoSync">
      <text class="menu-k">数据同步</text>
      <text class="menu-v">增量 / 全量</text>
    </div>

    <div class="menu-item" onclick="toggleDebug">
      <text class="menu-k">Debug 模式</text>
      <text class="menu-v">{{debugMode ? '开' : '关'}}</text>
    </div>

    <div class="menu-item" onclick="gotoStorage">
      <text class="menu-k">本地存储检查</text>
      <text class="menu-v">看空/非空</text>
    </div>

    <div class="menu-item danger" onclick="clearCache">
      <text class="menu-k">清空题目数据</text>
      <text class="menu-v">索引+正文</text>
    </div>

    <div class="menu-item" onclick="changeFontSize">
      <text class="menu-k">公式字号</text>
      <text class="menu-v">{{fontSize}}px</text>
    </div>

    <div class="menu-item" onclick="editHost">
      <text class="menu-k">服务地址</text>
      <text class="menu-v small">{{serverHost}}</text>
    </div>

    <input class="btn-back" type="button" value="返回" onclick="goBack" />
  </div>
</template>

<script>
import router from "@system.router"
import prompt from "@system.prompt"
import store from "../../common/ansstore.js"

export default {
  private: {
    fontSize: 14,
    debugMode: false,
    serverHost: ""
  },
  onInit() {
    this.loadSettings()
  },
  onShow() {
    this.loadSettings()
  },
  loadSettings() {
    store.storageGet("reader_font_size", (data) => {
      const size = parseInt(data, 10)
      if (!isNaN(size)) this.fontSize = size
    })
    store.storageGet("debug_mode", (data) => {
      this.debugMode = (data === "true" || data === true)
    })
    store.getServerHost((host) => {
      this.serverHost = host
    })
  },
  toggleDebug() {
    this.debugMode = !this.debugMode
    store.storageSet("debug_mode", String(this.debugMode), () => {
      prompt.showToast({ message: this.debugMode ? "Debug 已开" : "Debug 已关" })
    })
  },
  gotoStorage() {
    router.push({ uri: "/pages/storage" })
  },
  gotoSync() {
    router.push({ uri: "/pages/sync" })
  },
  changeFontSize() {
    const sizes = [12, 14, 16]
    const nextIndex = (sizes.indexOf(this.fontSize) + 1) % sizes.length
    this.fontSize = sizes[nextIndex]
    store.storageSet("reader_font_size", String(this.fontSize), () => {
      prompt.showToast({ message: this.fontSize + "px" })
    })
  },
  editHost() {
    prompt.showPrompt({
      title: "服务地址",
      message: this.serverHost,
      success: (data) => {
        const val = data && (data.value || data.text || data)
        if (!val || typeof val !== "string") return
        store.storageSet("server_host", val.replace(/\/$/, ""), () => {
          this.serverHost = val.replace(/\/$/, "")
          prompt.showToast({ message: "已保存地址" })
        })
      }
    })
  },
  dialogConfirmed(data) {
    if (!data) return false
    const idx = data.index !== undefined ? data.index : (data.data && data.data.index)
    return Number(idx) === 1
  },
  clearCache() {
    prompt.showDialog({
      title: "确认清空",
      message: "将删除题目索引、每题正文和旧版 local_answers。设置项保留。",
      buttons: [
        { text: "取消", color: "#888888" },
        { text: "确定清空", color: "#ef4444" }
      ],
      success: (data) => {
        if (!this.dialogConfirmed(data)) return
        store.clearAnswers(() => {
          prompt.showToast({ message: "题目数据已清空" })
        })
      }
    })
  },
  goBack() {
    router.back()
  }
}
</script>

<style>
.container {
  flex-direction: column;
  background-color: #0b0d12;
  width: 100%;
  height: 100%;
  padding: 12px;
}
.title {
  font-size: 16px;
  color: #f3f5f8;
  font-weight: bold;
  margin-bottom: 10px;
  text-align: center;
}
.menu-item {
  height: 44px;
  background-color: #151a24;
  border-radius: 10px;
  margin-bottom: 8px;
  padding-left: 12px;
  padding-right: 12px;
  flex-direction: row;
  justify-content: space-between;
  align-items: center;
}
.danger {
  background-color: #2a1518;
}
.menu-k {
  font-size: 13px;
  color: #f3f5f8;
}
.menu-v {
  font-size: 11px;
  color: #f5c15d;
}
.small {
  font-size: 9px;
  color: #93c5fd;
}
.btn-back {
  width: 100%;
  height: 32px;
  background-color: #1a1f2b;
  color: #ffffff;
  font-size: 13px;
  border-radius: 16px;
  margin-top: 8px;
}
</style>
