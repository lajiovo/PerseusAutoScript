      border-radius: 21px;
      margin-bottom: 8px;
      justify-content: center;
      align-items: center;
    }

    .tab-btn {
      width: 150px;
      height: 38px;
      text-align: center;
      font-size: 15px;
      color: #94a3b8;
      border-radius: 19px;
      line-height: 38px;
    }

    .active-tab {
