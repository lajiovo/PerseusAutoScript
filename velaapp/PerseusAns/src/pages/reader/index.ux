<template>
  <div class="container">
    <!-- Top Fixed Bar -->
    <div class="top-bar">
      <text class="title">{{ansTitle}}</text>
      <text class="page-indicator">{{currentPage + 1}}/{{totalPages}}</text>
    </div>

    <!-- Main Content Container with Horizontal Scroll Support -->
    <scroll class="reader-scroll" scroll-x="true" scroll-y="true">
      <div class="content-body" id="contentBody">
        <!-- Rendered paragraphs and AST nodes based on minimalist AST mapping -->
        <block for="{{pageNodes}}">
          <!-- Headings -->
          <text class="h1" if="{{$item.type === 'h1'}}">{{$item.value}}</text>
          <text class="h2" if="{{$item.type === 'h2'}}">{{$item.value}}</text>
          <text class="h3" if="{{$item.type === 'h3'}}">{{$item.value}}</text>

          <!-- Paragraph / Container (m / paragraph) -->
          <div class="paragraph" if="{{$item.type === 'm' || $item.type === 'paragraph'}}">
            <block for="{{$item.children}}">
              <!-- Text node ['t', 'text'][cite: 1] -->
              <text class="text" if="{{$item.type === 't'}}">{{$item.value}}</text>
              <text class="bold-text" if="{{$item.type === 'bold'}}">{{$item.value}}</text>

              <!-- Horizontal combination ['r', ...][cite: 1] -->
              <div class="ast-horizontal" if="{{$item.type === 'r'}}">
                <block for="{{$item.children}}">
                  <text class="text" if="{{$item.type === 't'}}">{{$item.value}}</text>
                  <text class="bold-text" if="{{$item.type === 'bold'}}">{{$item.value}}</text>
                  <!-- Nested fraction in horizontal -->
                  <div class="ast-fraction" if="{{$item.type === 'f'}}">
                    <text class="ast-num">{{$item.num.value || $item.num}}</text>
                    <div class="ast-line"></div>
                    <text class="ast-den">{{$item.den.value || $item.den}}</text>
                  </div>
                  <!-- Nested sup in horizontal -->
                  <div class="ast-sup-wrap" if="{{$item.type === 'sup_g'}}">
                    <text class="text">{{$item.base.value || $item.base}}</text>
                    <text class="ast-sup">{{$item.sup.value || $item.sup}}</text>
                  </div>
                  <!-- Nested sub in horizontal -->
                  <div class="ast-sub-wrap" if="{{$item.type === 'sub_g'}}">
                    <text class="text">{{$item.base.value || $item.base}}</text>
                    <text class="ast-sub">{{$item.sub.value || $item.sub}}</text>
                  </div>
                </block>
              </div>

              <!-- Fraction ['f', num, den][cite: 1] -->
              <div class="ast-fraction" if="{{$item.type === 'f'}}">
                <text class="ast-num">{{$item.num.value || $item.num}}</text>
                <div class="ast-line"></div>
                <text class="ast-den">{{$item.den.value || $item.den}}</text>
              </div>

              <!-- Square root ['sq', content][cite: 1] -->
              <div class="ast-sqrt" if="{{$item.type === 'sq'}}">
                <text class="ast-symbol">√</text>
                <text class="ast-sqrt-text">{{$item.content.value || $item.content}}</text>
              </div>

              <!-- Superscript combination ['sup_g', base, sup][cite: 1] -->
              <div class="ast-sup-wrap" if="{{$item.type === 'sup_g'}}">
                <text class="text">{{$item.base.value || $item.base}}</text>
                <text class="ast-sup">{{$item.sup.value || $item.sup}}</text>
              </div>

              <!-- Subscript combination ['sub_g', base, sub][cite: 1] -->
              <div class="ast-sub-wrap" if="{{$item.type === 'sub_g'}}">
                <text class="text">{{$item.base.value || $item.base}}</text>
                <text class="ast-sub">{{$item.sub.value || $item.sub}}</text>
              </div>

              <!-- Vector ['vec', content][cite: 1] -->
              <div class="ast-vec-wrap" if="{{$item.type === 'vec'}}">
                <text class="ast-vec-arrow">→name</text>
                <text class="text">{{$item.content.value || $item.content}}</text>
              </div>

              <!-- Chemical Equation Sequence ['chem_seq', [nodes]][cite: 1] -->
              <div class="chem-seq-container" if="{{$item.type === 'chem_seq'}}">
                <block for="{{$item.children}}">
                  <text class="text" if="{{$item.type === 't'}}">{{$item.value}}</text>
                  <!-- Chemical reaction arrow ['chem_a', symbol, top, bot][cite: 1] -->
                  <div class="chem-arrow-box" if="{{$item.type === 'chem_a'}}">
                    <text class="chem-arrow-top">{{$item.top ? ($item.top.value || $item.top) : ''}}</text>
                    <text class="chem-arrow-symbol">{{$item.symbol || '→'}}</text>
                    <text class="chem-arrow-bot">{{$item.bot ? ($item.bot.value || $item.bot) : ''}}</text>
                  </div>
                </block>
              </div>

              <!-- Chemical Reaction Arrow standalone -->
              <div class="chem-arrow-box" if="{{$item.type === 'chem_a'}}">
                <text class="chem-arrow-top">{{$item.top ? ($item.top.value || $item.top) : ''}}</text>
                <text class="chem-arrow-symbol">{{$item.symbol || '→'}}</text>
                <text class="chem-arrow-bot">{{$item.bot ? ($item.bot.value || $item.bot) : ''}}</text>
              </div>
            </block>
          </div>
        </block>
      </div>
    </scroll>

    <!-- Bottom Fixed Bar -->
    <div class="bottom-bar">
      <input class="btn" type="button" value="上一页" onclick="prevPage" />
      <input class="btn" type="button" value="下一页" onclick="nextPage" />
      <input class="btn-danger" type="button" value="删除" onclick="confirmDelete" />
    </div>
  </div>
</template>

<script>
import router from "@system.router"
import storage from "@system.storage"
import prompt from "@system.prompt"

export default {
  private: {
    ansId: null,
    ansTitle: "",
    totalPages: 1,
    currentPage: 0,
    pagesData: [],
    pageNodes: []
  },
  onInit(params) {
    this.ansId = params.ansId;
    this.loadAnswerData();
  },
  loadAnswerData() {
    storage.get({
      key: "local_answers",
      success: (data) => {
        if (data) {
          try {
            let list = JSON.parse(data);
            let item = list.find(i => String(i.id) === String(this.ansId) || String(i.ans_id) === String(this.ansId));
            if (item) {
              this.ansTitle = item.title;
              this.totalPages = item.total_pages || (item.pages ? item.pages.length : 1);
              this.pagesData = item.pages || [];
              this.updatePageContent();
            }
          } catch(e) {}
        }
      }
    });
  },
  // 核心：根据极简 AST 节点对照表将数组结构转换为视图渲染对象[cite: 1]
  normalizeAst(node) {
    if (!node) return null;
    if (Array.isArray(node)) {
      const tag = node[0];
      switch (tag) {
        case 't':
          return { type: 't', value: node[1] };
        case 'r':
          return { type: 'r', children: (node[1] || []).map(n => this.normalizeAst(n)) };
        case 'f':
          return { type: 'f', num: this.normalizeAst(node[1]), den: this.normalizeAst(node[2]) };
        case 'sq':
          return { type: 'sq', content: this.normalizeAst(node[1]) };
        case 'sup_g':
          return { type: 'sup_g', base: this.normalizeAst(node[1]), sup: this.normalizeAst(node[2]) };
        case 'sub_g':
          return { type: 'sub_g', base: this.normalizeAst(node[1]), sub: this.normalizeAst(node[2]) };
        case 'vec':
          return { type: 'vec', content: this.normalizeAst(node[1]) };
        case 'chem_seq':
          return { type: 'chem_seq', children: (node[1] || []).map(n => this.normalizeAst(n)) };
        case 'chem_a':
          return { type: 'chem_a', symbol: node[1], top: this.normalizeAst(node[2]), bot: this.normalizeAst(node[3]) };
        case 'm':
        case 'paragraph':
          return { type: 'm', children: node.slice(1).map(n => this.normalizeAst(n)) };
        case 'txt':
          return { type: 't', value: node[1] };
        default:
          return { type: 't', value: String(node[1] || '') };
      }
    } else if (typeof node === 'object') {
      return {
        type: node.block_type || node.type || 't',
        value: node.value || node.raw || '',
        children: (node.content || node.children || []).map(n => this.normalizeAst(n)),
        num: node.numerator ? this.normalizeAst(node.numerator) : null,
        den: node.denominator ? this.normalizeAst(node.denominator) : null,
        base: node.base ? this.normalizeAst(node.base) : null,
        sup: node.value ? this.normalizeAst(node.value) : null,
        sub: node.value ? this.normalizeAst(node.value) : null,
        content: node.content ? this.normalizeAst(node.content) : null
      };
    }
    return { type: 't', value: String(node) };
  },
  updatePageContent() {
    if (this.pagesData && this.pagesData.length > this.currentPage) {
      let currentPageObj = this.pagesData[this.currentPage];
      let rawBlocks = currentPageObj.blocks || currentPageObj || [];
      // 对当前页面的所有区块应用极简 AST 归一化处理
      this.pageNodes = rawBlocks.map(block => this.normalizeAst(block));
    }
  },
  prevPage() {
    if (this.currentPage > 0) {
      this.currentPage--;
      this.updatePageContent();
    }
  },
  nextPage() {
    if (this.currentPage < this.totalPages - 1) {
      this.currentPage++;
      this.updatePageContent();
    }
  },
  confirmDelete() {
    prompt.showDialog({
      title: "确认删除",
      message: "是否删除该题目解析？",
      buttons: [
        { text: "取消", color: "#666666" },
        { text: "删除", color: "#ff0000" }
      ],
      success: (data) => {
        if (data.index === 1) {
          storage.get({
            key: "local_answers",
            success: (sData) => {
              if (sData) {
                let list = JSON.parse(sData);
                list = list.filter(i => String(i.id) !== String(this.ansId));
                storage.set({
                  key: "local_answers",
                  value: JSON.stringify(list),
                  success: () => {
                    prompt.showToast({ message: "已删除" });
                    router.back();
                  }
                });
              }
            }
          });
        }
      }
    });
  }
}
</script>

<style>
.container {
  flex-direction: column;
  background-color: #000000;
  width: 100%;
  height: 100%;
  padding: 8px;
}
.top-bar {
  flex-direction: row;
  justify-content: space-between;
  align-items: center;
  height: 35px;
  border-bottom-width: 1px;
  border-bottom-color: #333333;
}
.title {
  font-size: 14px;
  color: #ffaa00;
  font-weight: bold;
}
.page-indicator {
  font-size: 12px;
  color: #aaaaaa;
}
.reader-scroll {
  flex: 1;
  margin-top: 5px;
  margin-bottom: 5px;
}
.content-body {
  flex-direction: column;
  padding: 5px;
}
.h1 {
  font-size: 18px;
  font-weight: bold;
  color: #ffffff;
  margin-bottom: 6px;
}
.h2 {
  font-size: 16px;
  font-weight: bold;
  color: #ffffff;
  margin-bottom: 5px;
}
.h3 {
  font-size: 14px;
  font-weight: bold;
  color: #ffffff;
  margin-bottom: 4px;
}
.paragraph {
  flex-direction: row;
  flex-wrap: wrap;
  margin-bottom: 6px;
  align-items: center;
}
.text {
  font-size: 13px;
  color: #e0e0e0;
}
.bold-text {
  font-size: 13px;
  color: #ffcc00;
  font-weight: bold;
}
.ast-horizontal {
  flex-direction: row;
  align-items: center;
  margin: 0 2px;
}
.ast-fraction {
  flex-direction: column;
  align-items: center;
  margin: 0 4px;
}
.ast-num {
  font-size: 11px;
  color: #00ffff;
  border-bottom-width: 1px;
  border-bottom-color: #00ffff;
  padding-bottom: 1px;
}
.ast-line {
  width: 100%;
  height: 1px;
  background-color: #00ffff;
}
.ast-den {
  font-size: 11px;
  color: #00ffff;
  padding-top: 1px;
}
.ast-sqrt {
  flex-direction: row;
  align-items: center;
  margin: 0 4px;
}
.ast-symbol {
  font-size: 14px;
  color: #ff00ff;
}
.ast-sqrt-text {
  font-size: 12px;
  color: #ff00ff;
  border-top-width: 1px;
  border-top-color: #ff00ff;
  padding-top: 1px;
}
.ast-sup-wrap {
  flex-direction: row;
  align-items: flex-start;
}
.ast-sup {
  font-size: 9px;
  color: #38bdf8;
  margin-left: 1px;
}
.ast-sub-wrap {
  flex-direction: row;
  align-items: flex-end;
}
.ast-sub {
  font-size: 19px;
  color: #38bdf8;
  margin-left: 1px;
}
.ast-vec-wrap {
  flex-direction: row;
  align-items: center;
  position: relative;
}
.ast-vec-arrow {
  font-size: 9px;
  color: #ff5722;
}
.chem-seq-container {
  flex-direction: row;
  align-items: center;
  flex-wrap: wrap;
}
.chem-arrow-box {
  flex-direction: column;
  align-items: center;
  margin: 0 4px;
}
.chem-arrow-top {
  font-size: 8px;
  color: #a855f7;
}
.chem-arrow-symbol {
  font-size: 12px;
  color: #a855f7;
}
.chem-arrow-bot {
  font-size: 8px;
  color: #a855f7;
}
.bottom-bar {
  flex-direction: row;
  justify-content: space-between;
  height: 35px;
  align-items: center;
}
.btn {
  width: 90px;
  height: 30px;
  background-color: #333333;
  color: #ffffff;
  font-size: 12px;
  border-radius: 4px;
}
.btn-danger {
  width: 70px;
  height: 30px;
  background-color: #aa0000;
  color: #ffffff;
  font-size: 12px;
  border-radius: 4px;
}
</style>