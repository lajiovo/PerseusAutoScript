<template>
  <div class="container">
    <text class="page-title">学习记录与计时</text>

    <!-- 科目选择区 -->
    <text class="section-label">选择科目:</text>
    <div class="subject-scroll">
      <div 
        for="{{ subjects }}" 
        class="subject-chip {{ selectedSubject.id === $item.id ? 'active-chip' : '' }}" 
        onclick="selectSubject($item)"
      >
        <text class="chip-text">{{ $item.name }}</text>
      </div>
    </div>

    <!-- 模式切换：计时器 vs 手动输入 -->
    <div class="tab-bar">
      <text class="tab-btn {{ mode === 'timer' ? 'active-tab' : '' }}" onclick="switchMode('timer')">秒表计时</text>
      <text class="tab-btn {{ mode === 'manual' ? 'active-tab' : '' }}" onclick="switchMode('manual')">手动录入</text>
    </div>

    <!-- 计时器视图 -->
    <div if="{{ mode === 'timer' }}" class="mode-box">
      <text class="timer-display">{{ formattedTime }}</text>
      <div class="btn-row">
        <input if="{{ !isRunning }}" class="action-btn start-btn" type="button" value="开始计时" onclick="startTimer" />
        <input if="{{ isRunning }}" class="action-btn stop-btn" type="button" value="结束保存" onclick="stopTimer" />
        <input class="action-btn reset-btn" type="button" value="重置" onclick="resetTimer" />
      </div>
    </div>

    <!-- 手动输入视图 -->
    <div if="{{ mode === 'manual' }}" class="mode-box">
      <text class="sub-tip">选择本次学习时长 (分钟):</text>
      <div class="manual-row">
        <input class="step-btn" type="button" value="-10" onclick="adjustManual(-10)" />
        <input class="step-btn" type="button" value="-5" onclick="adjustManual(-5)" />
        <text class="manual-val">{{ manualMinutes }}分钟</text>
        <input class="step-btn" type="button" value="+5" onclick="adjustManual(5)" />
        <input class="step-btn" type="button" value="+10" onclick="adjustManual(10)" />
      </div>
      <input class="action-btn start-btn" type="button" value="保存手动记录" onclick="saveManualRecord" />
    </div>

    <input class="back-btn" type="button" value="返回首页" onclick="goBack" />
  </div>
</template>

<script>
import router from "@system.router";
import storage from "@system.storage";
import { SUBJECTS, STORAGE_KEY } from "../../common/constants.js";

export default {
  private: {
    subjects: SUBJECTS,
    selectedSubject: SUBJECTS[0],
    mode: 'timer', // timer or manual
    seconds: 0,
    isRunning: false,
    timerId: null,
    formattedTime: "00:00:00",
    manualMinutes: 30
  },

  onInit() {
    this.selectedSubject = this.subjects[0];
  },

  onDestroy() {
    if (this.timerId) {
      clearInterval(this.timerId);
    }
  },

  selectSubject(sub) {
    this.selectedSubject = sub;
  },

  switchMode(m) {
    this.mode = m;
  },

  startTimer() {
    if (this.isRunning) return;
    this.isRunning = true;
    this.timerId = setInterval(() => {
      this.seconds++;
      this.updateFormattedTime();
    }, 1000);
  },

  stopTimer() {
    if (!this.isRunning && this.seconds === 0) return;
    if (this.timerId) {
      clearInterval(this.timerId);
      this.timerId = null;
    }
    this.isRunning = false;

    const mins = Math.round(this.seconds / 60);
    if (mins > 0 || this.seconds > 10) {
      this.saveRecord(Math.max(1, mins));
    } else {
      prompt.showToast({ message: "时间太短，未保存" });
    }
    this.seconds = 0;
    this.updateFormattedTime();
  },

  resetTimer() {
    if (this.timerId) {
      clearInterval(this.timerId);
      this.timerId = null;
    }
    this.isRunning = false;
    this.seconds = 0;
    this.updateFormattedTime();
  },

  updateFormattedTime() {
    const h = String(Math.floor(this.seconds / 3600)).padStart(2, '0');
    const m = String(Math.floor((this.seconds % 3600) / 60)).padStart(2, '0');
    const s = String(this.seconds % 60).padStart(2, '0');
    this.formattedTime = `${h}:${m}:${s}`;
  },

  adjustManual(delta) {
    this.manualMinutes = Math.max(5, this.manualMinutes + delta);
  },

  saveManualRecord() {
    this.saveRecord(this.manualMinutes);
  },

  saveRecord(minutes) {
    const record = {
      subjectId: this.selectedSubject.id,
      subjectName: this.selectedSubject.name,
      minutes: minutes,
      timestamp: new Date().getTime(),
      dateStr: new Date().toLocaleDateString()
    };

    storage.get({
      key: STORAGE_KEY,
      success: (data) => {
        let list = [];
        if (data) {
          try {
            list = JSON.parse(data);
          } catch (e) {}
        }
        list.push(record);
        storage.set({
          key: STORAGE_KEY,
          value: JSON.stringify(list),
          success: () => {
            router.push({ uri: "/pages/stats" });
          }
        });
      },
      fail: () => {
        let list = [record];
        storage.set({
          key: STORAGE_KEY,
          value: JSON.stringify(list),
          success: () => {
            router.push({ uri: "/pages/stats" });
          }
        });
      }
    });
  },

  goBack() {
    router.back();
  }
};
</script>

