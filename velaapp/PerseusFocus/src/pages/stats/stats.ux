<template>
  <div class="container">
    <div class="card-absolute">
      <text class="page-title">学习统计看板</text>

      <!-- 日期切换控制区：默认展示“今天”，支持向前/向后最多切换 10 天缓存日期 -->
      <div class="date-switcher">
        <input class="switch-arrow" type="button" value="<" onclick="prevDay" />
        <text class="date-display">{{ currentDateStr }}</text>
        <input class="switch-arrow" type="button" value=">" onclick="nextDay" />
      </div>

      <!-- 总时长展示 -->
      <div class="summary-card">
        <text class="summary-label">当日总学习时长</text>
        <text class="summary-value">{{ totalMinutes }} 分钟</text>
      </div>

      <!-- 科目统计列表 -->
      <text class="section-title">各科目投入时长与占比</text>
      <div class="list-container">
        <div for="{{ statsList }}" class="stat-item">
          <text class="sub-name">{{ $item.name }}</text>
          <div class="bar-bg">
            <div class="bar-fill" style="width: {{ $item.percent }}%; background-color: {{ $item.color }};"></div>
          </div>
          <text class="sub-time">{{ $item.minutes }}分钟({{ $item.percent }}%)</text>
        </div>
      </div>

      <div class="bottom-btns">
        <input class="nav-btn" type="button" value="智能规划" onclick="gotoPlan" />
        <input class="nav-btn" type="button" value="返回首页" onclick="goHome" />
      </div>
    </div>
  </div>
</template>

<script>
import router from "@system.router";
import storage from "@system.storage";
import { SUBJECTS, STORAGE_KEY } from "../../common/constants.js";

export default {
  private: {
    totalMinutes: 0,
    statsList: [],
    allRecords: [],
    dateOffset: 0, // 0表示今天，-1表示昨天，以此类推，支持往前最多10天
    currentDateStr: ""
  },

  onInit() {
    this.updateTargetDateString();
    this.loadStats();
  },

  updateTargetDateString() {
    const d = new Date();
    d.setDate(d.getDate() + this.dateOffset);
    this.currentDateStr = d.getFullYear() + '-' + String(d.getMonth() + 1).padStart(2, '0') + '-' + String(d.getDate()).padStart(2, '0');
    if (this.dateOffset === 0) {
      this.currentDateStr += " (今天)";
    }
  },

  prevDay() {
    if (this.dateOffset > -10) {
      this.dateOffset--;
      this.updateTargetDateString();
      this.renderStatsForCurrentDate();
    }
  },

  nextDay() {
    if (this.dateOffset < 0) {
      this.dateOffset++;
      this.updateTargetDateString();
      this.renderStatsForCurrentDate();
    }
  },

  loadStats() {
    storage.get({
      key: STORAGE_KEY,
      success: (data) => {
        if (!data) {
          this.allRecords = [];
          this.renderStatsForCurrentDate();
          return;
        }
        try {
          this.allRecords = JSON.parse(data);
          this.renderStatsForCurrentDate();
        } catch (e) {
          this.allRecords = [];
          this.renderStatsForCurrentDate();
        }
      },
      fail: () => {
        this.allRecords = [];
        this.renderStatsForCurrentDate();
      }
    });
  },

  renderStatsForCurrentDate() {
    // 纯净日期匹配
    const targetBaseDate = new Date();
    targetBaseDate.setDate(targetBaseDate.getDate() + this.dateOffset);
    const targetStr = targetBaseDate.getFullYear() + '-' + String(targetBaseDate.getMonth() + 1).padStart(2, '0') + '-' + String(targetBaseDate.getDate()).padStart(2, '0');

    let totals = {};
    SUBJECTS.forEach(s => {
      totals[s.id] = { name: s.name, minutes: 0, color: s.color };
    });

    let sum = 0;
    this.allRecords.forEach(item => {
      // 兼容 item.dateStr 或 从 timestamp 解析
      let itemDateStr = item.dateStr;
      if (!itemDateStr && item.timestamp) {
        const dt = new Date(item.timestamp);
        itemDateStr = dt.getFullYear() + '-' + String(dt.getMonth() + 1).padStart(2, '0') + '-' + String(dt.getDate()).padStart(2, '0');
      }

      if (itemDateStr && itemDateStr.startsWith(targetStr)) {
        if (totals[item.subjectId]) {
          totals[item.subjectId].minutes += item.minutes;
          sum += item.minutes;
        }
      }
    });

    this.totalMinutes = sum;

    let res = [];
    SUBJECTS.forEach(s => {
      const m = totals[s.id].minutes;
      const pct = sum > 0 ? Math.round((m / sum) * 100) : 0;
      res.push({
        id: s.id,
        name: s.name,
        minutes: m,
        percent: pct,
        color: s.color
      });
    });
    this.statsList = res;
  },

  gotoPlan() {
    router.push({ uri: "/pages/plan" });
  },

  goHome() {
    router.replace({ uri: "/pages/index" });
  }
};
</script>

